<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="GamePerfCenter.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:GamePerfCenter.Helpers">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="Styles/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <helpers:StatusToBrushConverter x:Key="StatusBrush" />
            <helpers:StatusToTextConverter x:Key="StatusText" />
            <helpers:RiskToBrushConverter x:Key="RiskBrush" />
            <helpers:RiskToTextConverter x:Key="RiskText" />
            <helpers:LevelToBrushConverter x:Key="LevelBrush" />
            <helpers:BoolToVisibilityConverter x:Key="BoolVisible" />
            <helpers:InverseBoolToVisibilityConverter x:Key="InverseBoolVisible" />
            <helpers:NullToVisibilityConverter x:Key="NullVisible" />
            <helpers:InverseNullToVisibilityConverter x:Key="InverseNullVisible" />
            <helpers:FileSizeConverter x:Key="FileSize" />
            <helpers:BoolToGlyphConverter x:Key="BoolGlyph" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
