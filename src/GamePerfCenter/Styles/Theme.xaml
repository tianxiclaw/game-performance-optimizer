<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="AppBgBrush" Color="#0A0E17" />
            <SolidColorBrush x:Key="PaneBrush" Color="#E6111826" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="#111827" />
            <SolidColorBrush x:Key="Surface2Brush" Color="#172033" />
            <SolidColorBrush x:Key="CardBrush" Color="#131C2B" />
            <LinearGradientBrush x:Key="CardSurfaceBrush" StartPoint="0,0" EndPoint="0.35,1">
                <GradientStop Color="#16202F" Offset="0" />
                <GradientStop Color="#111A27" Offset="1" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="CardHoverBrush" Color="#1A2436" />
            <SolidColorBrush x:Key="BorderBrush" Color="#243249" />
            <SolidColorBrush x:Key="BorderStrongBrush" Color="#31425D" />
            <SolidColorBrush x:Key="TextBrush" Color="#E6EDF7" />
            <SolidColorBrush x:Key="SubTextBrush" Color="#9AA9BE" />
            <SolidColorBrush x:Key="MutedTextBrush" Color="#7C8CA3" />
            <SolidColorBrush x:Key="AccentBrush" Color="#22D3EE" />
            <SolidColorBrush x:Key="AccentSoftBrush" Color="#15303D" />
            <SolidColorBrush x:Key="AccentForegroundBrush" Color="#04141A" />
            <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#22D3EE" Offset="0" />
                <GradientStop Color="#3B82F6" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="AppBackdropBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#060A12" Offset="0" />
                <GradientStop Color="#0B1424" Offset="0.55" />
                <GradientStop Color="#080C15" Offset="1" />
            </LinearGradientBrush>
            <RadialGradientBrush x:Key="NebulaBrush">
                <GradientStop Color="#3022D3EE" Offset="0" />
                <GradientStop Color="#000B1424" Offset="1" />
            </RadialGradientBrush>
            <RadialGradientBrush x:Key="GaugeGlowBrush">
                <GradientStop Color="#3D22D3EE" Offset="0" />
                <GradientStop Color="#00101A28" Offset="1" />
            </RadialGradientBrush>
            <LinearGradientBrush x:Key="HeroSurfaceBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#172838" Offset="0" />
                <GradientStop Color="#101A28" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="HeroBorderBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#2B4A63" Offset="0" />
                <GradientStop Color="#1E3146" Offset="1" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
            <SolidColorBrush x:Key="OkBrush" Color="#22C55E" />
            <SolidColorBrush x:Key="OkSoftBrush" Color="#12301F" />
            <SolidColorBrush x:Key="WarnBrush" Color="#F59E0B" />
            <SolidColorBrush x:Key="WarnSoftBrush" Color="#33240C" />
            <SolidColorBrush x:Key="DangerBrush" Color="#FB7185" />
            <SolidColorBrush x:Key="DangerSoftBrush" Color="#351A22" />
            <SolidColorBrush x:Key="InfoBrush" Color="#60A5FA" />
            <SolidColorBrush x:Key="InfoSoftBrush" Color="#15243D" />
            <SolidColorBrush x:Key="OverlayBrush" Color="#B3000000" />
            <SolidColorBrush x:Key="QrPanelBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="NavigationViewItemForeground" Color="#9AA9BE" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="#22D3EE" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundPointerOver" Color="#E6EDF7" />
            <LinearGradientBrush x:Key="NavigationViewItemBackgroundSelected" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#173B49" Offset="0" />
                <GradientStop Color="#162B45" Offset="1" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="#1A2436" />
            <LinearGradientBrush x:Key="NavigationViewSelectionIndicatorForeground" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#22D3EE" Offset="0" />
                <GradientStop Color="#3B82F6" Offset="1" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="#1A2436" />
            <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#15303D" />
            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#1A3A48" />
            <SolidColorBrush x:Key="ListViewItemForegroundPointerOver" Color="#E6EDF7" />
            <SolidColorBrush x:Key="ListViewItemForegroundSelected" Color="#E6EDF7" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="AppBgBrush" Color="#F4F7FB" />
            <SolidColorBrush x:Key="PaneBrush" Color="#E6FFFFFF" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="Surface2Brush" Color="#EEF3FA" />
            <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
            <LinearGradientBrush x:Key="CardSurfaceBrush" StartPoint="0,0" EndPoint="0.35,1">
                <GradientStop Color="#FFFFFF" Offset="0" />
                <GradientStop Color="#FAFCFE" Offset="1" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="CardHoverBrush" Color="#F7FAFD" />
            <SolidColorBrush x:Key="BorderBrush" Color="#DCE5F0" />
            <SolidColorBrush x:Key="BorderStrongBrush" Color="#C6D3E3" />
            <SolidColorBrush x:Key="TextBrush" Color="#0F172A" />
            <SolidColorBrush x:Key="SubTextBrush" Color="#475569" />
            <SolidColorBrush x:Key="MutedTextBrush" Color="#5B6B80" />
            <SolidColorBrush x:Key="AccentBrush" Color="#00738C" />
            <SolidColorBrush x:Key="AccentSoftBrush" Color="#E0F5FA" />
            <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFF" />
            <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#00738C" Offset="0" />
                <GradientStop Color="#1D4ED8" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="AppBackdropBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#F6F9FD" Offset="0" />
                <GradientStop Color="#EDF3FA" Offset="0.55" />
                <GradientStop Color="#F4F7FB" Offset="1" />
            </LinearGradientBrush>
            <RadialGradientBrush x:Key="NebulaBrush">
                <GradientStop Color="#1A00738C" Offset="0" />
                <GradientStop Color="#00EDF3FA" Offset="1" />
            </RadialGradientBrush>
            <RadialGradientBrush x:Key="GaugeGlowBrush">
                <GradientStop Color="#1F00738C" Offset="0" />
                <GradientStop Color="#00F6FBFF" Offset="1" />
            </RadialGradientBrush>
            <LinearGradientBrush x:Key="HeroSurfaceBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FFFFFF" Offset="0" />
                <GradientStop Color="#F6FBFF" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="HeroBorderBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#CFE4F1" Offset="0" />
                <GradientStop Color="#DEE8F3" Offset="1" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
            <SolidColorBrush x:Key="OkBrush" Color="#15803D" />
            <SolidColorBrush x:Key="OkSoftBrush" Color="#E6F6EC" />
            <SolidColorBrush x:Key="WarnBrush" Color="#B45309" />
            <SolidColorBrush x:Key="WarnSoftBrush" Color="#FDF3E2" />
            <SolidColorBrush x:Key="DangerBrush" Color="#BE123C" />
            <SolidColorBrush x:Key="DangerSoftBrush" Color="#FDE8EE" />
            <SolidColorBrush x:Key="InfoBrush" Color="#1D4ED8" />
            <SolidColorBrush x:Key="InfoSoftBrush" Color="#E8EEFE" />
            <SolidColorBrush x:Key="OverlayBrush" Color="#66000000" />
            <SolidColorBrush x:Key="QrPanelBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="NavigationViewItemForeground" Color="#475569" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="#00738C" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundPointerOver" Color="#0F172A" />
            <LinearGradientBrush x:Key="NavigationViewItemBackgroundSelected" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#DDF4FA" Offset="0" />
                <GradientStop Color="#E4ECFB" Offset="1" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="#F7FAFD" />
            <LinearGradientBrush x:Key="NavigationViewSelectionIndicatorForeground" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#00738C" Offset="0" />
                <GradientStop Color="#1D4ED8" Offset="1" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="#F7FAFD" />
            <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#E0F5FA" />
            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#D4F0F7" />
            <SolidColorBrush x:Key="ListViewItemForegroundPointerOver" Color="#0F172A" />
            <SolidColorBrush x:Key="ListViewItemForegroundSelected" Color="#0F172A" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <FontFamily x:Key="AppFontFamily">Segoe UI Variable Text, Microsoft YaHei UI, Segoe UI</FontFamily>
    <FontFamily x:Key="DisplayFontFamily">Segoe UI Variable Display, Microsoft YaHei UI, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFontFamily">Cascadia Mono, Consolas, Microsoft YaHei UI</FontFamily>

    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="PageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFontFamily}" />
        <Setter Property="FontSize" Value="30" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource TextBrush}" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFontFamily}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource TextBrush}" />
    </Style>

    <Style x:Key="BodyTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{ThemeResource TextBrush}" />
        <Setter Property="LineHeight" Value="20" />
    </Style>

    <Style x:Key="SecondaryTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{ThemeResource SubTextBrush}" />
        <Setter Property="LineHeight" Value="19" />
    </Style>

    <Style x:Key="CaptionTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="{ThemeResource MutedTextBrush}" />
    </Style>

    <Style x:Key="MonoTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{ThemeResource SubTextBrush}" />
    </Style>

    <Style x:Key="MetricValueStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFontFamily}" />
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource TextBrush}" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <Style x:Key="MetricUnitStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{ThemeResource MutedTextBrush}" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="Margin" Value="4,0,0,5" />
    </Style>

    <Style x:Key="CardBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="18" />
    </Style>

    <Style x:Key="HeroBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource HeroSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource HeroBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="Padding" Value="24" />
    </Style>

    <Style x:Key="FeaturedCardBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource HeroSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource HeroBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="Padding" Value="22,20" />
    </Style>

    <!-- 扁平行：用分隔线组织密集数据，不再逐行包卡 -->
    <Style x:Key="DataRowStyle" TargetType="Border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{ThemeResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="0,11" />
    </Style>

    <Style x:Key="DataRowLastStyle" TargetType="Border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0,11,0,2" />
    </Style>

    <Style x:Key="DividerStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource BorderBrush}" />
        <Setter Property="Height" Value="1" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

    <Style x:Key="PillBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource Surface2Brush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="9,3" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="AccentButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource AccentGradientBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource AccentForegroundBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="SubtleButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource Surface2Brush}" />
        <Setter Property="Foreground" Value="{ThemeResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="GhostButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource SubTextBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="DangerGhostButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource DangerBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="DangerButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource DangerSoftBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource DangerBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource DangerBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="IconButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource SubTextBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="CardListViewItemStyle" TargetType="ListViewItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,0,0,6" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="MinHeight" Value="0" />
    </Style>

    <Style x:Key="PlainListViewItemStyle" TargetType="ListViewItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,0,0,6" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="MinHeight" Value="0" />
    </Style>

    <Style x:Key="DenseListViewItemStyle" TargetType="ListViewItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="MinHeight" Value="0" />
    </Style>

    <Style x:Key="SettingsRowStyle" TargetType="Border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{ThemeResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="0,16" />
    </Style>
</ResourceDictionary>
