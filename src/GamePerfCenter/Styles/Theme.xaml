        <Setter Property="Padding" Value="0,15" />
    </Style>

    <!-- 左侧导航项：完全自定义选中态与紧凑态 -->
    <Style x:Key="NavItemStyle" TargetType="controls:NavItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinHeight" Value="42" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource AccentBrush}" />
        <Setter Property="FocusVisualSecondaryBrush" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:NavItem">
                    <Grid Height="42" Margin="4,0,4,0" Background="Transparent">
                        <controls:TechPanel x:Name="Face" Cut="9" Fill="Transparent" Stroke="Transparent"
                                            IsHitTestVisible="False" />
                        <Border x:Name="Bar" Width="3" HorizontalAlignment="Left"
                                Background="{ThemeResource AccentBrush}" Visibility="Collapsed" />
                        <Grid x:Name="Inner" Padding="14,0,12,0" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="IconColumn" Width="20" />
                                <ColumnDefinition x:Name="LabelColumn" Width="*" />
                                <ColumnDefinition x:Name="CodeColumn" Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon x:Name="Icon" Glyph="{TemplateBinding Glyph}" FontSize="16"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <TextBlock x:Name="LabelText" Grid.Column="1" Text="{TemplateBinding Label}"
                                       FontSize="13.5" FontWeight="Normal" TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <TextBlock x:Name="CodeText" Grid.Column="2" Text="{TemplateBinding Code}"
                                       FontFamily="{StaticResource MonoFontFamily}" FontSize="9"
                                       CharacterSpacing="80" Foreground="{ThemeResource MutedTextBrush}"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 统一页头：强调条 + 标题 + 模块代号 + 操作区；窄窗口自动下移操作区 -->
    <Style x:Key="PageHeaderStyle" TargetType="controls:PageHeader">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:PageHeader">
                    <Grid x:Name="HeaderRoot" ColumnSpacing="18" RowSpacing="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid x:Name="TitleBlock">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="AccentBar" Width="4" Height="32" VerticalAlignment="Top" Margin="0,6,0,0"
                                    Background="{ThemeResource AccentBrush}" />
                            <StackPanel Grid.Column="1" Margin="14,0,0,0" Spacing="4">
                                <TextBlock x:Name="TitleText" Text="{TemplateBinding Title}"
                                           Style="{StaticResource PageTitleStyle}" />
                                <TextBlock x:Name="SubtitleText" Text="{TemplateBinding Subtitle}"
                                           Style="{StaticResource SecondaryTextStyle}"
                                           TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>

                        <StackPanel x:Name="RightBlock" Grid.Column="1" Spacing="8" VerticalAlignment="Top"
                                    HorizontalAlignment="Right" MinWidth="180">
                            <TextBlock x:Name="CodeBlock" Text="{TemplateBinding Code}"
                                       Style="{StaticResource TechCodeStyle}" HorizontalAlignment="Right" />
                            <Border x:Name="CodeLine" Height="1" Background="{ThemeResource BorderBrush}" />
                            <ContentPresenter x:Name="ActionsHost" Content="{TemplateBinding Content}"
                                              HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 隐式样式：页面只需写 <controls:PageHeader .../> 即可获得统一模板 -->
    <Style TargetType="controls:PageHeader" BasedOn="{StaticResource PageHeaderStyle}" />
</ResourceDictionary>
