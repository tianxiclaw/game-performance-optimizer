<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="GamePerfCenter.Controls.CommandPalette"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GamePerfCenter.Controls">

    <Grid x:Name="Layer" Background="{ThemeResource OverlayBrush}" Visibility="Collapsed"
          AutomationProperties.Name="命令面板"
          Tapped="Layer_Tapped">
        <local:TechPanel x:Name="Card" MaxWidth="640" MaxHeight="560" Margin="24,88,24,24"
                         HorizontalAlignment="Stretch" VerticalAlignment="Top"
                         Padding="0" Radius="16" Cut="0"
                         Fill="{ThemeResource CardSurfaceBrush}"
                         Stroke="{ThemeResource BorderStrongBrush}" StrokeThickness="1"
                         TopLineBrush="{ThemeResource AccentDimBrush}" TopLineOpacity="0.9"
                         Tapped="Card_Tapped">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="56" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="34" />
                </Grid.RowDefinitions>

                <!-- 搜索行 -->
                <Grid Padding="16,0,14,0" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE721;" FontSize="15" VerticalAlignment="Center"
                              Foreground="{ThemeResource AccentBrush}" />
                    <TextBox x:Name="QueryBox" Grid.Column="1" VerticalAlignment="Center"
                             AutomationProperties.Name="命令面板搜索框"
                             Background="Transparent" BorderThickness="0" Padding="0"
                             FontSize="15" MinHeight="40"
                             PlaceholderText="搜索页面、优化项、游戏或命令..."
                             TextChanged="QueryBox_TextChanged" />
                    <Border Grid.Column="2" Background="{ThemeResource InsetBrush}"
                            BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1"
                            CornerRadius="5" Padding="6,2" VerticalAlignment="Center">
                        <TextBlock Text="ESC" FontFamily="{StaticResource MonoFontFamily}"
                                   FontSize="10" Foreground="{ThemeResource SubTextBrush}" />
                    </Border>
                </Grid>
                <Border Height="1" VerticalAlignment="Bottom" Margin="0,0,0,0"
                        Background="{ThemeResource BorderBrush}" Opacity="0.7" />

                <!-- 结果 -->
                <Grid Grid.Row="1" Margin="8,6,8,4">
                    <ListView x:Name="Results" SelectionMode="Single" IsItemClickEnabled="True"
                              ItemClick="Results_ItemClick"
                              ItemContainerStyle="{StaticResource PaletteItemStyle}"
                              Padding="0" MaxHeight="404">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:CommandItem">
                                <Grid ColumnSpacing="11" Padding="10,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="30" Height="30" CornerRadius="8"
                                            Background="{ThemeResource InsetBrush}"
                                            BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1"
                                            VerticalAlignment="Center">
                                        <FontIcon Glyph="{x:Bind Glyph}" FontSize="13"
                                                  Foreground="{ThemeResource SubTextBrush}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Title}" FontSize="13.5" FontWeight="SemiBold"
                                                   Foreground="{ThemeResource TextBrush}" MaxLines="1"
                                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                        <TextBlock Text="{x:Bind Detail}" Style="{StaticResource TechCodeStyle}"
                                                   MaxLines="1" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{x:Bind Group}"
                                               Style="{StaticResource TechMicroStyle}"
                                               VerticalAlignment="Center" Margin="0,0,4,0" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <StackPanel x:Name="EmptyText" VerticalAlignment="Center" HorizontalAlignment="Center"
                                Spacing="4" Visibility="Collapsed" IsHitTestVisible="False">
                        <TextBlock Text="NO MATCH" Style="{StaticResource TechLabelStyle}"
                                   Foreground="{ThemeResource DangerBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="换个关键词，或直接输入页面名。" Style="{StaticResource CaptionTextStyle}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <!-- 底部键位说明 -->
                <Grid Grid.Row="2" Padding="16,0" Background="{ThemeResource InsetBrush}">
                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <TextBlock Text="↑↓ 选择" Style="{StaticResource TechCodeStyle}" />
                        <TextBlock Text="↵ 执行" Style="{StaticResource TechCodeStyle}" />
                        <TextBlock Text="ESC 关闭" Style="{StaticResource TechCodeStyle}" />
                    </StackPanel>
                    <TextBlock x:Name="CountText" HorizontalAlignment="Right" VerticalAlignment="Center"
                               Style="{StaticResource TechCodeStyle}" />
                </Grid>
            </Grid>
        </local:TechPanel>
    </Grid>
</UserControl>
