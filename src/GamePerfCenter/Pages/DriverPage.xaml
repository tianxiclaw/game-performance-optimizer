<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="GamePerfCenter.Pages.DriverPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:GamePerfCenter.Models"
    NavigationCacheMode="Required"
    Background="Transparent">

    <Grid Padding="28,24,28,20" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="10">
            <StackPanel Spacing="4">
                <TextBlock Text="驱动中心" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="驱动是否正常、要不要更新：版本、厂商工具与变化记录。"
                           Style="{StaticResource SecondaryTextStyle}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6">
                <Button Content="打开设备管理器" Style="{StaticResource SubtleButtonStyle}" Click="OpenDeviceManager_Click" />
                <Button Content="刷新" Style="{StaticResource AccentButtonStyle}" Click="Refresh_Click"
                        ToolTipService.ToolTip="重新枚举显卡与驱动历史" />
            </StackPanel>
        </StackPanel>

        <InfoBar x:Name="PageInfo" Grid.Row="1" IsOpen="False" IsClosable="True" />

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0,0,4,8"
                      HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
                      HorizontalContentAlignment="Stretch">
            <StackPanel Spacing="16" MaxWidth="1500" HorizontalAlignment="Stretch">

                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="12">
                        <Grid>
                            <StackPanel Spacing="3">
                                <TextBlock Text="显示适配器" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="驱动版本来自 WMI，厂商工具路径来自本机安装记录"
                                           Style="{StaticResource CaptionTextStyle}" />
                            </StackPanel>
                            <TextBlock x:Name="DeviceCountText" HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Style="{StaticResource CaptionTextStyle}" />
                        </Grid>

                        <ItemsControl x:Name="DeviceList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:DriverDevice">
                                    <Border Style="{StaticResource DataRowStyle}" Padding="4,12">
                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Spacing="3">
                                                <TextBlock Text="{x:Bind Name}" FontSize="13.5" FontWeight="SemiBold"
                                                           Foreground="{ThemeResource TextBrush}" TextWrapping="Wrap" />
                                                <TextBlock Style="{StaticResource CaptionTextStyle}" TextWrapping="NoWrap">
                                                    <Run Text="{x:Bind Vendor}" />
                                                    <Run Text="  ·  " />
                                                    <Run Text="{x:Bind KindText}" />
                                                </TextBlock>
                                                <TextBlock Text="{x:Bind DriverText}" Style="{StaticResource SecondaryTextStyle}" />
                                                <Grid ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{x:Bind VramText}" Style="{StaticResource CaptionTextStyle}"
                                                               TextWrapping="NoWrap" />
                                                    <TextBlock Grid.Column="1" Text="{x:Bind PnpId}"
                                                               Style="{StaticResource CaptionTextStyle}"
                                                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                                               ToolTipService.ToolTip="{x:Bind PnpId}" />
                                                </Grid>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center"
                                                        HorizontalAlignment="Right">
                                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                                                    <Ellipse Width="6" Height="6" Fill="{ThemeResource OkBrush}"
                                                             VerticalAlignment="Center" />
                                                    <TextBlock Text="{x:Bind Status}" Style="{StaticResource CaptionTextStyle}" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                                                    <Button Content="{x:Bind ToolText}" Style="{StaticResource SubtleButtonStyle}"
                                                            Click="OpenTool_Click"
                                                            ToolTipService.ToolTip="打开厂商驱动工具，未安装则跳转官网" />
                                                    <Button Content="下载驱动" Style="{StaticResource GhostButtonStyle}"
                                                            Click="DownloadDriver_Click"
                                                            ToolTipService.ToolTip="打开厂商官方下载页面" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel x:Name="DeviceEmpty" Visibility="Collapsed" Spacing="6"
                                    HorizontalAlignment="Center" Margin="0,16">
                            <FontIcon Glyph="&#xE7F8;" FontSize="26" Foreground="{ThemeResource MutedTextBrush}" />
                            <TextBlock Text="未检测到显示适配器" Style="{StaticResource SecondaryTextStyle}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.15*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel Spacing="12">
                            <StackPanel Spacing="3">
                                <TextBlock Text="最近驱动变更" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="由本应用记录的驱动版本变化，用于排查意外回退"
                                           Style="{StaticResource CaptionTextStyle}" />
                            </StackPanel>
                            <ItemsControl x:Name="ChangeList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:DriverChange">
                                        <Border Style="{StaticResource DataRowStyle}" Padding="4,10">
                                            <StackPanel Spacing="3">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{x:Bind Name}" FontSize="13" FontWeight="SemiBold"
                                                               Foreground="{ThemeResource TextBrush}" />
                                                    <TextBlock Text="{x:Bind Type}" Style="{StaticResource CaptionTextStyle}"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap">
                                                    <Run Text="{x:Bind From}" />
                                                    <Run Text="  →  " Foreground="{ThemeResource SubTextBrush}" />
                                                    <Run Text="{x:Bind To}" />
                                                </TextBlock>
                                                <TextBlock Text="{x:Bind At}" Style="{StaticResource CaptionTextStyle}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel x:Name="ChangeEmpty" Visibility="Collapsed" Spacing="6"
                                        HorizontalAlignment="Center" Margin="0,12">
                                <TextBlock Text="暂无驱动变更记录" Style="{StaticResource SecondaryTextStyle}" />
                                <TextBlock Text="首次运行后会自动建立基线" Style="{StaticResource CaptionTextStyle}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                        <StackPanel Spacing="12">
                            <StackPanel Spacing="3">
                                <TextBlock Text="设备驱动档案" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="记录每台设备的 INF、版本与日期"
                                           Style="{StaticResource CaptionTextStyle}" />
                            </StackPanel>
                            <ListView x:Name="HistoryList" SelectionMode="None"
                                      ItemContainerStyle="{StaticResource DenseListViewItemStyle}">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:DriverHistRow">
                                        <Border Style="{StaticResource DataRowStyle}" Padding="4,10">
                                            <StackPanel Spacing="3">
                                                <TextBlock Text="{x:Bind Name}" FontSize="13" FontWeight="SemiBold"
                                                           Foreground="{ThemeResource TextBrush}" TextWrapping="Wrap" />
                                                <TextBlock Text="{x:Bind MetaText}" Style="{StaticResource CaptionTextStyle}"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <TextBlock x:Name="HistoryEmpty" Text="暂无驱动档案" Style="{StaticResource CaptionTextStyle}"
                                       Visibility="Collapsed" HorizontalAlignment="Center" Margin="0,12" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Style="{StaticResource CardBorderStyle}" Padding="16">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE946;" FontSize="15" Foreground="{ThemeResource InfoBrush}"
                                  VerticalAlignment="Top" Margin="0,1,0,0" />
                        <TextBlock Grid.Column="1"
                                   Text="驱动更新建议使用 NVIDIA App、AMD Software 或 Intel 驱动支持助手。系统不会自动下载或替换驱动包；若发现版本意外回退，请查看左侧变更记录。"
                                   Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
