<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="GamePerfCenter.Pages.StartupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:GamePerfCenter.Models"
    NavigationCacheMode="Required"
    Background="Transparent">

    <Grid Padding="28,24,28,20" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="10">
            <StackPanel Spacing="4">
                <TextBlock Text="启动项与后台" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="哪些程序会自启、后台在跑什么：只读展示，不在应用内结束进程。"
                           Style="{StaticResource SecondaryTextStyle}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6">
                <Button Content="启动文件夹" Style="{StaticResource GhostButtonStyle}" Click="OpenStartupFolder_Click" />
                <Button Content="任务管理器" Style="{StaticResource SubtleButtonStyle}" Click="OpenTaskManager_Click" />
                <Button Content="刷新" Style="{StaticResource AccentButtonStyle}" Click="Refresh_Click" />
            </StackPanel>
        </StackPanel>

        <InfoBar x:Name="PageInfo" Grid.Row="1" IsOpen="False" IsClosable="True" />

        <Grid Grid.Row="2" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.05*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,12">
                        <StackPanel Spacing="3">
                            <TextBlock Text="开机启动项" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock x:Name="StartupHint" Text="来自注册表 Run 与启动文件夹"
                                       Style="{StaticResource CaptionTextStyle}" />
                        </StackPanel>
                        <FontIcon Glyph="&#xE7B5;" FontSize="15" HorizontalAlignment="Right" VerticalAlignment="Center"
                                  Foreground="{ThemeResource SubTextBrush}" />
                    </Grid>

                    <ListView x:Name="StartupList" Grid.Row="1" SelectionMode="None"
                              ItemContainerStyle="{StaticResource DenseListViewItemStyle}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:StartupEntry">
                                <Border Style="{StaticResource DataRowStyle}" Padding="4,10">
                                    <StackPanel Spacing="3">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{x:Bind Name}" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{ThemeResource TextBrush}" TextWrapping="NoWrap" />
                                            <TextBlock Text="{x:Bind Source}" Style="{StaticResource CaptionTextStyle}"
                                                       VerticalAlignment="Center" TextWrapping="NoWrap" />
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind Command}" Style="{StaticResource MonoTextStyle}" FontSize="11"
                                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                                   ToolTipService.ToolTip="{x:Bind Command}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <StackPanel x:Name="StartupEmpty" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                                Spacing="6" Visibility="Collapsed">
                        <TextBlock Text="没有发现启动项" Style="{StaticResource SecondaryTextStyle}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,12">
                        <StackPanel Spacing="3">
                            <TextBlock Text="内存占用 Top 14" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="按工作集排序 · 仅展示，不提供结束操作"
                                       Style="{StaticResource CaptionTextStyle}" />
                        </StackPanel>
                        <TextBlock x:Name="BackgroundHint" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Style="{StaticResource CaptionTextStyle}" />
                    </Grid>

                    <ListView x:Name="BackgroundList" Grid.Row="1" SelectionMode="None"
                              ItemContainerStyle="{StaticResource DenseListViewItemStyle}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:BackgroundProc">
                                <Border Style="{StaticResource DataRowStyle}" Padding="4,9">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{x:Bind Name}" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{ThemeResource TextBrush}" MaxLines="1"
                                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                            <TextBlock Style="{StaticResource CaptionTextStyle}" TextWrapping="NoWrap">
                                                <Run Text="{x:Bind PidText}" />
                                                <Run Text="  ·  " />
                                                <Run Text="{x:Bind StateText}" />
                                            </TextBlock>
                                            <TextBlock Text="{x:Bind TitleText}" Style="{StaticResource CaptionTextStyle}"
                                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" MaxWidth="420"
                                                       ToolTipService.ToolTip="{x:Bind TitleText}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{x:Bind MemText}" FontSize="12.5" FontWeight="SemiBold"
                                                   Foreground="{ThemeResource SubTextBrush}" VerticalAlignment="Center"
                                                   TextWrapping="NoWrap" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
