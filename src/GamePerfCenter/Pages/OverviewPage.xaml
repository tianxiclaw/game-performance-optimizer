<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="GamePerfCenter.Pages.OverviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:GamePerfCenter.Models"
    NavigationCacheMode="Required"
    Background="Transparent">

    <Grid Padding="28,24,28,20" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 页头：左边是问题，右边是动作 -->
        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock Text="概览" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="这台机器现在怎么样：实时负载、优化进度与硬件状态。"
                           Style="{StaticResource SecondaryTextStyle}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Button Content="刷新状态" Style="{StaticResource SubtleButtonStyle}" Click="Refresh_Click"
                        ToolTipService.ToolTip="重新读取硬件与优化项状态" />
                <Button Content="打开优化项" Style="{StaticResource GhostButtonStyle}" Click="OpenItems_Click"
                        ToolTipService.ToolTip="查看全部优化项并手动勾选" />
            </StackPanel>
        </Grid>

        <InfoBar x:Name="PendingBar" Grid.Row="1" IsOpen="False" Severity="Warning" Title="系统等待重启"
                 Message="部分优化项需要重启后才能生效。" IsClosable="False" />

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0,0,4,8"
                      HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
                      HorizontalContentAlignment="Stretch">
            <StackPanel Spacing="16" MaxWidth="1500" HorizontalAlignment="Stretch">

                <InfoBar x:Name="ActionInfo" IsOpen="False" IsClosable="True" />

                <!-- 主块：实时负载是这台机器“现在”的答案，优化进度是下一步 -->
                <Border Style="{StaticResource FeaturedCardBorderStyle}" Padding="24,22">
                    <Grid x:Name="HeroGrid" ColumnSpacing="26" RowSpacing="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid x:Name="LivePanel">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Bottom">
                                <TextBlock Text="实时负载" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock x:Name="LiveStamp" Text="等待首次采样"
                                           Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Bottom"
                                           Margin="0,0,0,2" />
                            </StackPanel>

                            <Grid x:Name="LiveGrid" Grid.Row="1" ColumnSpacing="22" Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- CPU / GPU 环形仪表：数值来自外壳统一采样 -->
                                <StackPanel Orientation="Horizontal" Spacing="18" VerticalAlignment="Center">
                                    <StackPanel Spacing="6" Width="132">
                                        <Grid Width="132" Height="132"
                                              ToolTipService.ToolTip="CPU 使用率，2 秒采样，全核心">
                                            <Ellipse Width="116" Height="116"
                                                     Stroke="{ThemeResource BorderBrush}" StrokeThickness="9"
                                                     Opacity="0.55" />
                                            <Path x:Name="CpuRing" Width="132" Height="132" Stretch="None"
                                                  Stroke="{ThemeResource AccentGradientBrush}" StrokeThickness="9"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                                        Spacing="0">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <TextBlock x:Name="CpuValue" Text="--"
                                                               Style="{StaticResource LiveValueStyle}" FontSize="36" />
                                                    <TextBlock Text="%" Style="{StaticResource LiveUnitStyle}" />
                                                </StackPanel>
                                                <TextBlock Text="CPU 使用率" Style="{StaticResource CaptionTextStyle}"
                                                           HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </Grid>
                                        <Grid Width="132" Height="24"
                                              ToolTipService.ToolTip="CPU 最近约 90 秒的真实采样趋势">
                                            <Border Height="1" VerticalAlignment="Bottom"
                                                    Background="{ThemeResource BorderBrush}" Opacity="0.55" />
                                            <Canvas Width="132" Height="23" HorizontalAlignment="Left"
                                                    VerticalAlignment="Top">
                                                <Polyline x:Name="CpuSparkLine" Stroke="{ThemeResource AccentBrush}"
                                                          StrokeThickness="1.4" />
                                            </Canvas>
                                        </Grid>
                                    </StackPanel>

                                    <StackPanel Spacing="6" Width="132">
                                        <Grid Width="132" Height="132"
                                              ToolTipService.ToolTip="GPU 3D 引擎负载，2 秒采样">
                                            <Ellipse Width="116" Height="116"
                                                     Stroke="{ThemeResource BorderBrush}" StrokeThickness="9"
                                                     Opacity="0.55" />
                                            <Path x:Name="GpuRing" Width="132" Height="132" Stretch="None"
                                                  Stroke="{ThemeResource AccentGradientBrush}" StrokeThickness="9"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                                        Spacing="0">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <TextBlock x:Name="GpuValue" Text="--"
                                                               Style="{StaticResource LiveValueStyle}" FontSize="36" />
                                                    <TextBlock Text="%" Style="{StaticResource LiveUnitStyle}" />
                                                </StackPanel>
                                                <TextBlock x:Name="GpuRingLabel" Text="GPU 3D"
                                                           Style="{StaticResource CaptionTextStyle}"
                                                           HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </Grid>
                                        <Grid Width="132" Height="24"
                                              ToolTipService.ToolTip="GPU 最近约 90 秒的真实采样趋势">
                                            <Border Height="1" VerticalAlignment="Bottom"
                                                    Background="{ThemeResource BorderBrush}" Opacity="0.55" />
                                            <Canvas Width="132" Height="23" HorizontalAlignment="Left"
                                                    VerticalAlignment="Top">
                                                <Polyline x:Name="GpuSparkLine" Stroke="{ThemeResource AccentBrush}"
                                                          StrokeThickness="1.4" />
                                            </Canvas>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel x:Name="LiveStats" Grid.Column="1" Spacing="14"
                                            VerticalAlignment="Center" MinWidth="200">
                                    <StackPanel Spacing="4">
                                        <Grid>
                                            <TextBlock Text="内存" Style="{StaticResource BodyTextStyle}"
                                                       FontWeight="SemiBold" />
                                            <TextBlock x:Name="RamValue" Text="--" HorizontalAlignment="Right"
                                                       Style="{StaticResource MonoTextStyle}" FontSize="12" />
                                        </Grid>
                                        <ProgressBar x:Name="RamBar" Minimum="0" Maximum="100" Height="4"
                                                     Foreground="{ThemeResource AccentGradientBrush}"
                                                     Background="{ThemeResource Surface2Brush}" />
                                        <TextBlock x:Name="RamHint" Text="读取中..." Style="{StaticResource CaptionTextStyle}" />
                                    </StackPanel>

                                    <StackPanel Spacing="4">
                                        <Grid>
                                            <TextBlock Text="网络" Style="{StaticResource BodyTextStyle}"
                                                       FontWeight="SemiBold" />
                                            <TextBlock x:Name="NetValue" Text="--" HorizontalAlignment="Right"
                                                       Style="{StaticResource MonoTextStyle}" FontSize="12" />
                                        </Grid>
                                        <TextBlock x:Name="NetHint" Text="上行 --" Style="{StaticResource CaptionTextStyle}" />
                                    </StackPanel>

                                    <Border Height="1" Background="{ThemeResource BorderBrush}" Opacity="0.65" />
                                    <TextBlock x:Name="LiveDeviceLine" Text="正在读取显示设备..."
                                               Style="{StaticResource CaptionTextStyle}" MaxLines="1"
                                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                </StackPanel>
                            </Grid>

                            <!-- 实时区底部落脚：供电、计数器与上次应用都是真实状态 -->
                            <StackPanel Grid.Row="3" Spacing="8" Margin="0,18,0,0">
                                <Border Height="1" Background="{ThemeResource BorderBrush}" Opacity="0.6" />
                                <Grid ColumnSpacing="18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="供电" Style="{StaticResource CaptionTextStyle}" />
                                        <TextBlock x:Name="SignalPower" Text="—" Style="{StaticResource BodyTextStyle}"
                                                   FontSize="12.5" TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="GPU 计数器" Style="{StaticResource CaptionTextStyle}" />
                                        <TextBlock x:Name="SignalGpu" Text="—" Style="{StaticResource BodyTextStyle}"
                                                   FontSize="12.5" TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="2">
                                        <TextBlock Text="上次应用" Style="{StaticResource CaptionTextStyle}" />
                                        <TextBlock x:Name="SignalApply" Text="—" Style="{StaticResource BodyTextStyle}"
                                                   FontSize="12.5" TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <Border x:Name="PendingDivider" Grid.Column="1" Width="1"
                                Background="{ThemeResource BorderBrush}" Margin="0,2" />

                        <StackPanel x:Name="PendingPanel" Grid.Column="2" Width="292" Spacing="0"
                                    VerticalAlignment="Stretch">
                            <TextBlock Text="优化进度" Style="{StaticResource SectionTitleStyle}" />
                            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,6,0,0">
                                <TextBlock x:Name="PendingCount" Text="--"
                                           Style="{StaticResource PendingValueStyle}" VerticalAlignment="Bottom" />
                                <TextBlock Text="项待优化" Style="{StaticResource BodyTextStyle}"
                                           VerticalAlignment="Bottom" Margin="0,0,0,4" />
                            </StackPanel>
                            <ProgressBar x:Name="CompletionBar" Minimum="0" Maximum="100" Height="4"
                                         Margin="0,10,0,0" Foreground="{ThemeResource AccentGradientBrush}"
                                         Background="{ThemeResource Surface2Brush}" />
                            <TextBlock x:Name="AppliedText" Text="已生效 -- 项"
                                       Style="{StaticResource CaptionTextStyle}" Margin="0,6,0,0" />
                            <TextBlock x:Name="StatusHeadline" Text="正在读取本机状态..."
                                       Style="{StaticResource BodyTextStyle}" FontWeight="SemiBold"
                                       Margin="0,12,0,0" />
                            <TextBlock x:Name="StatusDetail" Text="正在采集硬件与优化项状态。"
                                       Style="{StaticResource SecondaryTextStyle}" Margin="0,4,0,0"
                                       TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" />

                            <StackPanel Spacing="6" Margin="0,12,0,0">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE945;" FontSize="12" VerticalAlignment="Center"
                                              Foreground="{ThemeResource SubTextBrush}" />
                                    <TextBlock x:Name="RecoText" Grid.Column="1" Text="低风险推荐 -- 项"
                                               Style="{StaticResource CaptionTextStyle}" TextWrapping="NoWrap"
                                               TextTrimming="CharacterEllipsis" />
                                </Grid>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE823;" FontSize="12" VerticalAlignment="Center"
                                              Foreground="{ThemeResource SubTextBrush}" />
                                    <TextBlock x:Name="RebootText" Grid.Column="1" Text="重启状态：读取中"
                                               Style="{StaticResource CaptionTextStyle}" TextWrapping="NoWrap"
                                               TextTrimming="CharacterEllipsis" />
                                </Grid>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE72E;" FontSize="12" VerticalAlignment="Center"
                                              Foreground="{ThemeResource SubTextBrush}" />
                                    <TextBlock x:Name="SecurityText" Grid.Column="1" Text="安全与存储：读取中"
                                               Style="{StaticResource CaptionTextStyle}" TextWrapping="NoWrap"
                                               TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,16,0,0">
                                <Button Content="预览变更" Style="{StaticResource SubtleButtonStyle}"
                                        Click="Preview_Click" ToolTipService.ToolTip="只读预演，不写入系统" />
                                <Button x:Name="ApplyRecommendedButton" Content="应用推荐项"
                                        Style="{StaticResource AccentButtonStyle}" Click="ApplyRecommended_Click"
                                        ToolTipService.ToolTip="应用全部低风险推荐项，应用前自动备份原值" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 硬件与系统状态 -->
                <Grid x:Name="BottomGrid" ColumnSpacing="16" RowSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.3*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border x:Name="HardwareCard" Style="{StaticResource CardBorderStyle}">
                        <StackPanel Spacing="6">
                            <Grid>
                                <TextBlock Text="硬件概览" Style="{StaticResource SectionTitleStyle}" />
                                <StackPanel Orientation="Horizontal" Spacing="8"
                                            HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock x:Name="HardwareUpdated" VerticalAlignment="Center"
                                               Style="{StaticResource CaptionTextStyle}" />
                                    <Button Content="完整诊断" Style="{StaticResource GhostButtonStyle}"
                                            Click="OpenDiagnostics_Click" />
                                </StackPanel>
                            </Grid>
                            <TextBlock x:Name="HardwareSubtitle" Text="正在读取设备信息..."
                                       Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,2"
                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                            <ItemsControl x:Name="HardwareList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:DiagEntry">
                                        <Border Style="{StaticResource DataRowStyle}" Padding="0,8">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="88" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{x:Bind Name}" Style="{StaticResource CaptionTextStyle}"
                                                           VerticalAlignment="Top" Margin="0,2,0,0" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind Value}"
                                                           Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap"
                                                           ToolTipService.ToolTip="{x:Bind Hint}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border x:Name="SecurityCard" Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="安全与存储" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,2" />
                            <ItemsControl x:Name="DiagList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:DiagEntry">
                                        <Border Style="{StaticResource DataRowStyle}">
                                            <StackPanel Spacing="2">
                                                <Grid ColumnSpacing="10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{x:Bind Name}" Style="{StaticResource SecondaryTextStyle}" />
                                                    <TextBlock Grid.Column="1" Text="{x:Bind Value}"
                                                               Foreground="{x:Bind Level, Converter={StaticResource LevelBrush}}"
                                                               FontSize="12.5" FontWeight="SemiBold" TextWrapping="NoWrap" />
                                                </Grid>
                                                <TextBlock Text="{x:Bind Hint}" Style="{StaticResource CaptionTextStyle}"
                                                           Visibility="{x:Bind Hint, Converter={StaticResource NullVisible}}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
