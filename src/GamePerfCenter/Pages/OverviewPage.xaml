<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="GamePerfCenter.Pages.OverviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:GamePerfCenter.Models"
    xmlns:controls="using:GamePerfCenter.Controls"
    NavigationCacheMode="Required"
    Background="Transparent">

    <Grid Padding="24,20,24,16" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:PageHeader Title="概览"
                            Subtitle="这台电脑现在怎么样，需要做什么。">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Button Style="{StaticResource IconButtonStyle}" Click="Refresh_Click"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="刷新状态"
                        ToolTipService.ToolTip="重新读取硬件与优化项状态">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                </Button>
                <Button Content="查看全部优化项" Style="{StaticResource SubtleButtonStyle}" Click="OpenItems_Click"
                        ToolTipService.ToolTip="打开优化项列表，手动勾选要应用的项" />
            </StackPanel>
        </controls:PageHeader>

        <InfoBar x:Name="PendingBar" Grid.Row="1" IsOpen="False" Visibility="Collapsed" Severity="Warning"
                 Title="系统等待重启" Message="部分优化项需要重启后才能生效。" IsClosable="False" />

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0,0,4,8"
                      HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
                      HorizontalContentAlignment="Stretch">
            <StackPanel Spacing="14" MaxWidth="1500" HorizontalAlignment="Stretch">

                <InfoBar x:Name="ActionInfo" IsOpen="False" IsClosable="True"
                         Visibility="Collapsed" Closed="ActionInfo_Closed" />

                <Grid x:Name="HeroGrid" ColumnSpacing="16" RowSpacing="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="290" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 左：这台电脑 -->
                    <controls:TechPanel x:Name="HardwareCard" Style="{StaticResource TechCardStyle}"
                                        Padding="20,18" VerticalAlignment="Top">
                        <StackPanel Spacing="16">
                            <StackPanel Spacing="3">
                                <TextBlock Text="这台电脑" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock x:Name="MachineLine" Text="正在读取设备..."
                                           Style="{StaticResource CaptionTextStyle}"
                                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <StackPanel Spacing="14">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="28" Height="28" CornerRadius="8"
                                            Background="{ThemeResource InsetBrush}"
                                            BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1">
                                        <FontIcon Glyph="&#xE9D9;" FontSize="13"
                                                  Foreground="{ThemeResource SubTextBrush}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="处理器" Style="{StaticResource TechLabelStyle}" />
                                        <TextBlock x:Name="CpuFactValue" Text="读取中..." FontSize="15"
                                                   FontWeight="SemiBold" Foreground="{ThemeResource TextBrush}"
                                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                        <TextBlock x:Name="CpuFactSub" Text="CPU"
                                                   Style="{StaticResource CaptionTextStyle}"
                                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>

                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="28" Height="28" CornerRadius="8"
                                            Background="{ThemeResource InsetBrush}"
                                            BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1">
                                        <FontIcon Glyph="&#xE7F8;" FontSize="13"
                                                  Foreground="{ThemeResource SubTextBrush}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="显卡" Style="{StaticResource TechLabelStyle}" />
                                        <TextBlock x:Name="GpuFactValue" Text="读取中..." FontSize="15"
                                                   FontWeight="SemiBold" Foreground="{ThemeResource TextBrush}"
                                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                        <TextBlock x:Name="GpuFactSub" Text="GPU"
                                                   Style="{StaticResource CaptionTextStyle}"
                                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>

                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="28" Height="28" CornerRadius="8"
                                            Background="{ThemeResource InsetBrush}"
                                            BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1">
                                        <FontIcon Glyph="&#xE950;" FontSize="13"
                                                  Foreground="{ThemeResource SubTextBrush}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="内存" Style="{StaticResource TechLabelStyle}" />
                                        <TextBlock x:Name="RamFactValue" Text="读取中..." FontSize="15"
                                                   FontWeight="SemiBold" Foreground="{ThemeResource TextBrush}"
                                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                        <TextBlock x:Name="RamFactSub" Text="RAM"
                                                   Style="{StaticResource CaptionTextStyle}"
                                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>

                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="28" Height="28" CornerRadius="8"
                                            Background="{ThemeResource InsetBrush}"
                                            BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1">
                                        <FontIcon Glyph="&#xE7FC;" FontSize="13"
                                                  Foreground="{ThemeResource SubTextBrush}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="显示器" Style="{StaticResource TechLabelStyle}" />
                                        <TextBlock x:Name="DisplayFactValue" Text="读取中..." FontSize="15"
                                                   FontWeight="SemiBold" Foreground="{ThemeResource TextBrush}"
                                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                        <TextBlock x:Name="DisplayFactSub" Text="显示输出"
                                                   Style="{StaticResource CaptionTextStyle}"
                                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </controls:TechPanel>

                    <!-- 中：当前状态与唯一主操作 -->
                    <controls:TechPanel x:Name="StatusCard" Grid.Column="1"
                                        Style="{StaticResource TechHeroStyle}" Padding="24,20">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="0">
                            <TextBlock Text="当前状态" Style="{StaticResource TechLabelStyle}"
                                       HorizontalAlignment="Center" />

                            <Grid Width="164" Height="164" Margin="0,4,0,0">
                                <ProgressRing x:Name="StatusRing" Width="164" Height="164"
                                              IsIndeterminate="False" Minimum="0" Maximum="100" Value="0"
                                              Foreground="{ThemeResource AccentBrush}"
                                              Background="{ThemeResource Surface2Brush}" />
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="0">
                                    <TextBlock x:Name="PendingCount" Text="--" FontSize="50"
                                               FontWeight="SemiBold" Foreground="{ThemeResource TextBrush}"
                                               HorizontalAlignment="Center" LineHeight="54" />
                                    <TextBlock Text="项待优化" Style="{StaticResource SecondaryTextStyle}"
                                               HorizontalAlignment="Center" />
                                    <TextBlock x:Name="AppliedText" Text="已生效 -- 项"
                                               Style="{StaticResource CaptionTextStyle}"
                                               HorizontalAlignment="Center" Margin="0,4,0,0" />
                                </StackPanel>
                            </Grid>

                            <TextBlock x:Name="StatusHeadline" Text="正在读取本机状态..."
                                       FontSize="20" FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextBrush}"
                                       HorizontalAlignment="Center" Margin="0,6,0,0" />

                            <TextBlock x:Name="StatusDetail" Text="正在采集硬件与优化项状态，通常需要几秒。"
                                       Style="{StaticResource SecondaryTextStyle}" MaxWidth="400"
                                       TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,0" />

                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,12,0,0"
                                        HorizontalAlignment="Center">
                                <Button x:Name="PreviewButton" Content="先看看会改什么"
                                        Style="{StaticResource SubtleButtonStyle}"
                                        Click="Preview_Click"
                                        ToolTipService.ToolTip="只读预演，不会写入系统" />
                                <Button x:Name="ApplyRecommendedButton" Content="一键优化推荐项"
                                        Style="{StaticResource AccentButtonStyle}" Click="ApplyRecommended_Click"
                                        ToolTipService.ToolTip="应用全部低风险推荐项，应用前自动备份原值" />
                            </StackPanel>

                            <TextBlock Text="应用前自动备份原值，可随时在「备份还原」中恢复。"
                                       Style="{StaticResource CaptionTextStyle}"
                                       HorizontalAlignment="Center" TextAlignment="Center"
                                       TextWrapping="Wrap" Margin="0,8,0,0" />

                            <TextBlock x:Name="RebootText" Text="重启状态：读取中"
                                       Style="{StaticResource CaptionTextStyle}"
                                       HorizontalAlignment="Center" Margin="0,2,0,0" />
                        </StackPanel>
                    </controls:TechPanel>

                    <!-- 右：实时资源 -->
                    <controls:TechPanel x:Name="ResourceCard" Grid.Column="2"
                                        Style="{StaticResource TechCardStyle}" Padding="20,18"
                                        VerticalAlignment="Top">
                        <StackPanel Spacing="16">
                            <StackPanel Spacing="3">
                                <TextBlock Text="实时资源" Style="{StaticResource SectionTitleStyle}" />
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Ellipse x:Name="LivePulseDot" Width="6" Height="6"
                                             Fill="{ThemeResource OkBrush}" VerticalAlignment="Center" />
                                    <TextBlock x:Name="LiveStamp" Text="等待采样"
                                               Style="{StaticResource CaptionTextStyle}" />
                                </StackPanel>
                            </StackPanel>

                            <Grid x:Name="GaugeGrid" ColumnSpacing="24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="0" />
                                    <ColumnDefinition Width="0" />
                                    <ColumnDefinition Width="0" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel x:Name="CpuGauge" Spacing="6" Margin="0,0,0,16">
                                    <Grid>
                                        <TextBlock Text="CPU" Style="{StaticResource TechLabelStyle}" />
                                        <StackPanel Orientation="Horizontal" Spacing="2" HorizontalAlignment="Right">
                                            <TextBlock x:Name="CpuValue" Text="--"
                                                       FontSize="26" FontWeight="SemiBold"
                                                       Foreground="{ThemeResource TextBrush}" />
                                            <TextBlock Text="%" Style="{StaticResource LiveUnitStyle}" />
                                        </StackPanel>
                                    </Grid>
                                    <ProgressBar x:Name="CpuBar" Minimum="0" Maximum="100" Height="3"
                                                 Foreground="{ThemeResource AccentGradientBrush}"
                                                 Background="{ThemeResource Surface2Brush}" />
                                    <TextBlock Text="处理器占用" Style="{StaticResource CaptionTextStyle}" />
                                </StackPanel>

                                <StackPanel x:Name="GpuGauge" Grid.Row="1" Spacing="6" Margin="0,0,0,16">
                                    <Grid>
                                        <TextBlock Text="GPU" Style="{StaticResource TechLabelStyle}" />
                                        <StackPanel Orientation="Horizontal" Spacing="2" HorizontalAlignment="Right">
                                            <TextBlock x:Name="GpuValue" Text="--"
                                                       FontSize="26" FontWeight="SemiBold"
                                                       Foreground="{ThemeResource TextBrush}" />
                                            <TextBlock Text="%" Style="{StaticResource LiveUnitStyle}" />
                                        </StackPanel>
                                    </Grid>
                                    <ProgressBar x:Name="GpuBar" Minimum="0" Maximum="100" Height="3"
                                                 Foreground="{ThemeResource AccentGradientBrush}"
                                                 Background="{ThemeResource Surface2Brush}" />
                                    <TextBlock x:Name="GpuRingLabel" Text="显卡 3D 负载"
                                               Style="{StaticResource CaptionTextStyle}" />
                                </StackPanel>

                                <StackPanel x:Name="RamGauge" Grid.Row="2" Spacing="6" Margin="0,0,0,16">
                                    <Grid>
                                        <TextBlock Text="内存" Style="{StaticResource TechLabelStyle}" />
                                        <StackPanel Orientation="Horizontal" Spacing="2" HorizontalAlignment="Right">
                                            <TextBlock x:Name="RamValue" Text="--"
                                                       FontSize="26" FontWeight="SemiBold"
                                                       Foreground="{ThemeResource TextBrush}" />
                                            <TextBlock Text="%" Style="{StaticResource LiveUnitStyle}" />
                                        </StackPanel>
                                    </Grid>
                                    <ProgressBar x:Name="RamBar" Minimum="0" Maximum="100" Height="3"
                                                 Foreground="{ThemeResource AccentGradientBrush}"
                                                 Background="{ThemeResource Surface2Brush}" />
                                    <TextBlock x:Name="RamHint" Text="读取中..."
                                               Style="{StaticResource CaptionTextStyle}" />
                                </StackPanel>

                                <StackPanel x:Name="NetGauge" Grid.Row="3" Spacing="4">
                                    <Grid>
                                        <TextBlock Text="网络" Style="{StaticResource TechLabelStyle}" />
                                        <TextBlock x:Name="NetValue" Text="--" HorizontalAlignment="Right"
                                                   FontSize="16" FontWeight="SemiBold"
                                                   Foreground="{ThemeResource TextBrush}" />
                                    </Grid>
                                    <TextBlock x:Name="NetHint" Text="--"
                                               Style="{StaticResource CaptionTextStyle}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </controls:TechPanel>
                </Grid>

                <!-- 底部：上次优化与安全状态 -->
                <Grid x:Name="BottomGrid" ColumnSpacing="14" RowSpacing="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <controls:TechPanel x:Name="LastApplyCard" Style="{StaticResource TechCardStyle}"
                                        Padding="18,14">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Text="上次优化" FontSize="13.5" FontWeight="SemiBold"
                                           Foreground="{ThemeResource TextBrush}" />
                                <TextBlock x:Name="LastApplyText" Text="还没有优化记录"
                                           Style="{StaticResource SecondaryTextStyle}"
                                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="打开备份还原" Style="{StaticResource SubtleButtonStyle}"
                                    VerticalAlignment="Center" Click="OpenBackup_Click"
                                    ToolTipService.ToolTip="查看备份并恢复到优化前的状态" />
                        </Grid>
                    </controls:TechPanel>

                    <controls:TechPanel x:Name="SecurityCard" Grid.Column="1"
                                        Style="{StaticResource TechCardStyle}" Padding="18,14">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Text="安全与存储" FontSize="13.5" FontWeight="SemiBold"
                                           Foreground="{ThemeResource TextBrush}" />
                                <TextBlock x:Name="SecurityText" Text="正在检查..."
                                           Style="{StaticResource SecondaryTextStyle}"
                                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="查看诊断" Style="{StaticResource SubtleButtonStyle}"
                                    VerticalAlignment="Center" Click="OpenDiagnostics_Click"
                                    ToolTipService.ToolTip="打开完整诊断报告" />
                        </Grid>
                    </controls:TechPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
