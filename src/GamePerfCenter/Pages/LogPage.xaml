<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="GamePerfCenter.Pages.LogPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Required"
    Background="Transparent">

    <Grid Padding="28,24,28,20" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="10">
            <StackPanel Spacing="4">
                <TextBlock Text="运行日志" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="刚才发生了什么：引擎输出与界面操作记录，只留在本机。"
                           Style="{StaticResource SecondaryTextStyle}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="10">
                <ToggleSwitch x:Name="AutoRefresh" OffContent="自动刷新" OnContent="自动刷新" IsOn="True"
                              MinWidth="0" Toggled="AutoRefresh_Toggled" />
                <Button Content="打开日志目录" Style="{StaticResource GhostButtonStyle}" Click="OpenFolder_Click" />
                <Button Content="刷新" Style="{StaticResource AccentButtonStyle}" Click="Refresh_Click" />
                <Button Content="清理日志" Style="{StaticResource DangerGhostButtonStyle}" Click="Clear_Click"
                        ToolTipService.ToolTip="删除本机运行日志，不影响备份与优化记录" />
            </StackPanel>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="14,10">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE7C3;" FontSize="14" Foreground="{ThemeResource AccentBrush}"
                          VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                    <TextBlock x:Name="LogPathText" Style="{StaticResource MonoTextStyle}" FontSize="11.5"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="LogMetaText" Text="等待日志..."
                               Style="{StaticResource CaptionTextStyle}" />
                </StackPanel>
                <Button Grid.Column="2" Content="复制全部" Style="{StaticResource GhostButtonStyle}"
                        Click="Copy_Click" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="6">
            <TextBox x:Name="LogText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                     FontFamily="Consolas" FontSize="12" BorderThickness="0" Background="Transparent"
                     VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                     PlaceholderText="暂无日志。执行优化、恢复或诊断后会在此显示引擎输出。" />
        </Border>
    </Grid>
</Page>
