<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="GamePerfCenter.Pages.LogPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:GamePerfCenter.Controls"
    NavigationCacheMode="Required"
    Background="Transparent">

    <Grid Padding="24,20,24,16" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:PageHeader Title="运行日志"
                             Subtitle="引擎输出与界面操作记录，只留在本机。">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Button Content="打开日志目录" Style="{StaticResource GhostButtonStyle}" Click="OpenFolder_Click" />
                <Button Content="刷新" Style="{StaticResource SubtleButtonStyle}" Click="Refresh_Click" />
                <Button Content="清理日志" Style="{StaticResource DangerGhostButtonStyle}" Click="Clear_Click"
                        ToolTipService.ToolTip="删除本机运行日志，不影响备份与优化记录" />
            </StackPanel>
        </controls:PageHeader>

        <!-- 搜索与视图筛选：只影响显示，不修改日志文件 -->
        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="LogSearch" Width="260" MinHeight="32" PlaceholderText="搜索日志内容"
                     TextChanged="LogSearch_TextChanged" />
            <TextBlock x:Name="LogCount" Grid.Column="1" VerticalAlignment="Center"
                       Style="{StaticResource CaptionTextStyle}" TextTrimming="CharacterEllipsis" />
            <ToggleSwitch x:Name="OnlyErrors" Grid.Column="2" OffContent="仅看失败" OnContent="仅看失败"
                          MinWidth="0" VerticalAlignment="Center" Toggled="OnlyErrors_Toggled" />
            <ToggleSwitch x:Name="AutoRefresh" Grid.Column="3" OffContent="自动刷新" OnContent="自动刷新"
                          IsOn="True" MinWidth="0" VerticalAlignment="Center" Toggled="AutoRefresh_Toggled" />
        </Grid>

        <!-- 文件位置与状态 -->
        <Border Grid.Row="2" Background="{ThemeResource Surface2Brush}" CornerRadius="10" Padding="14,9">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE7C3;" FontSize="14" Foreground="{ThemeResource AccentBrush}"
                          VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                    <TextBlock x:Name="LogPathText" Style="{StaticResource MonoTextStyle}" FontSize="11.5"
                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                    <TextBlock x:Name="LogMetaText" Text="等待日志..."
                               Style="{StaticResource CaptionTextStyle}" TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button Grid.Column="2" Content="复制当前视图" Style="{StaticResource GhostButtonStyle}"
                        Click="Copy_Click" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <controls:TechPanel Grid.Row="3" Style="{StaticResource TechCardStyle}" Padding="10,8">
            <TextBox x:Name="LogText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                     FontFamily="Consolas" FontSize="12" BorderThickness="0" Background="Transparent"
                     VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                     PlaceholderText="暂无日志。执行优化、恢复或诊断后会在此显示引擎输出。" />
        </controls:TechPanel>
    </Grid>
</Page>