<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="GamePerfCenter.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Required"
    Background="Transparent">

    <Grid Padding="28,24,28,20" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel Spacing="5">
                <TextBlock Text="PREFERENCES · LOCAL PROFILE" Style="{StaticResource EyebrowTextStyle}" />
                <TextBlock Text="设置" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="外观与行为设置 · 修改后立即保存到 gui-settings.json"
                           Style="{StaticResource SecondaryTextStyle}" />
            </StackPanel>
            <Button Content="打开配置目录" Style="{StaticResource SubtleButtonStyle}"
                    HorizontalAlignment="Right" VerticalAlignment="Center" Click="OpenConfig_Click" />
        </Grid>

        <InfoBar x:Name="PageInfo" Grid.Row="1" IsOpen="False" IsClosable="True" />

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0,0,4,8">
            <Grid ColumnSpacing="16" MaxWidth="1500" HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.1*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="16">
                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel Spacing="0">
                            <StackPanel Spacing="3" Margin="0,0,0,6">
                                <TextBlock Text="外观" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="主题会同时应用到主窗口与弹窗"
                                           Style="{StaticResource CaptionTextStyle}" />
                            </StackPanel>

                            <Border Style="{StaticResource SettingsRowStyle}" BorderThickness="0">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="界面主题" Style="{StaticResource BodyTextStyle}" />
                                        <TextBlock Text="深色适合游戏场景，浅色适合办公环境"
                                                   Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="14"
                                                VerticalAlignment="Center">
                                        <RadioButton x:Name="DarkOption" Content="深色" GroupName="Theme"
                                                     Checked="Theme_Checked" />
                                        <RadioButton x:Name="LightOption" Content="浅色" GroupName="Theme"
                                                     Checked="Theme_Checked" />
                                        <RadioButton x:Name="SystemOption" Content="跟随系统" GroupName="Theme"
                                                     Checked="Theme_Checked" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel Spacing="0">
                            <StackPanel Spacing="3" Margin="0,0,0,6">
                                <TextBlock Text="行为" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="控制窗口生命周期与提醒" Style="{StaticResource CaptionTextStyle}" />
                            </StackPanel>

                            <Border Style="{StaticResource SettingsRowStyle}">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="关闭时最小化到托盘" Style="{StaticResource BodyTextStyle}" />
                                        <TextBlock Text="保留后台监控，可从托盘图标重新打开"
                                                   Style="{StaticResource CaptionTextStyle}" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="TraySwitch" Grid.Column="1"
                                                  Toggled="Setting_Toggled" VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource SettingsRowStyle}" BorderThickness="0">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="驱动变化提醒" Style="{StaticResource BodyTextStyle}" />
                                        <TextBlock Text="检测到驱动版本变化时给出提示"
                                                   Style="{StaticResource CaptionTextStyle}" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="DriverNotifySwitch" Grid.Column="1"
                                                  Toggled="Setting_Toggled" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="16">
                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="存储与配置" Style="{StaticResource SectionTitleStyle}" />

                            <StackPanel Spacing="5">
                                <TextBlock Text="程序目录" Style="{StaticResource CaptionTextStyle}" />
                                <TextBlock x:Name="BaseDirText" Style="{StaticResource MonoTextStyle}" FontSize="11.5"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Spacing="5">
                                <TextBlock Text="配置文件" Style="{StaticResource CaptionTextStyle}" />
                                <TextBlock x:Name="ConfigPathText" Style="{StaticResource MonoTextStyle}" FontSize="11.5"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="打开数据目录" Style="{StaticResource SubtleButtonStyle}" Click="OpenData_Click" />
                                <Button Content="打开备份目录" Style="{StaticResource GhostButtonStyle}" Click="OpenBackup_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="版本与更新" Style="{StaticResource SectionTitleStyle}" />
                            <StackPanel Spacing="4">
                                <TextBlock x:Name="VersionText" Style="{StaticResource BodyTextStyle}" />
                                <TextBlock Text="WinUI 3 便携版 · 自包含运行，无需安装 .NET"
                                           Style="{StaticResource CaptionTextStyle}" />
                                <TextBlock Text="界面框架 WinUI 3（Windows App SDK） · 引擎 Windows PowerShell 5.1"
                                           Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="检查更新" Style="{StaticResource AccentButtonStyle}" Click="CheckUpdate_Click" />
                                <Button Content="打开项目主页" Style="{StaticResource GhostButtonStyle}" Click="OpenRepo_Click" />
                            </StackPanel>
                            <Border Background="{ThemeResource Surface2Brush}" CornerRadius="10" Padding="12,10">
                                <TextBlock Text="更新通过 GitHub Releases 发布。便携版直接解压覆盖即可，配置与备份会保留在程序目录。"
                                           Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="重置" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="仅重置外观与行为设置，不会删除备份、日志或游戏库。"
                                       Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                            <Button Content="恢复默认设置" Style="{StaticResource DangerButtonStyle}"
                                    Click="Reset_Click" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
