<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="GamePerfCenter.Pages.GamesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:GamePerfCenter.Controls"
    xmlns:models="using:GamePerfCenter.Models"
    NavigationCacheMode="Required"
    Background="Transparent">

    <Grid Padding="24,18,24,18" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:PageHeader Title="游戏库" Code="GAMEPERF // GAME LIBRARY"
                             Subtitle="选中一个游戏，查看它的启动方案；方案只对该游戏生效，可随时还原。">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Button Content="手动添加" Style="{StaticResource SubtleButtonStyle}" Click="AddGame_Click"
                        ToolTipService.ToolTip="选择任意 exe 加入游戏库" />
                <Button Content="重新扫描" Style="{StaticResource SubtleButtonStyle}" Click="Scan_Click"
                        ToolTipService.ToolTip="重新扫描 Steam / Epic / WeGame / Xbox 游戏" />
            </StackPanel>
        </controls:PageHeader>

        <InfoBar x:Name="PageInfo" Grid.Row="1" IsOpen="False" IsClosable="True" Margin="0,0,0,2" />

        <Grid Grid.Row="2" ColumnSpacing="12" RowSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LibraryColumn" Width="352" />
                <ColumnDefinition x:Name="DetailColumn" Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="LibraryRow" Height="*" />
                <RowDefinition x:Name="DetailRow" Height="0" />
            </Grid.RowDefinitions>

            <!-- 左：本机游戏列表 -->
            <controls:TechPanel x:Name="LibraryCard" Style="{StaticResource TechCardStyle}"
                                Padding="14,12,14,8" Cut="12" CutBottom="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="01" Style="{StaticResource TechLabelStyle}"
                                       Foreground="{ThemeResource AccentBrush}" />
                            <TextBlock Text="本机游戏" Style="{StaticResource BodyTextStyle}" FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock x:Name="CountText" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Style="{StaticResource TechCodeStyle}" />
                    </Grid>

                    <Grid Grid.Row="1" ColumnSpacing="8" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="FILTER" Style="{StaticResource TechLabelStyle}" VerticalAlignment="Center" />
                        <TextBox x:Name="SearchBox" Grid.Column="1" PlaceholderText="搜索名称或路径..."
                                 MinHeight="32" TextChanged="SearchBox_TextChanged" />
                    </Grid>

                    <Grid Grid.Row="2" Margin="0,8,0,0">
                        <ListView x:Name="GameList" SelectionMode="Single"
                                  SelectionChanged="GameList_SelectionChanged"
                                  ItemContainerStyle="{StaticResource DenseListViewItemStyle}"
                                  Padding="0">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:GameInfo">
                                    <Grid Padding="4,8" DoubleTapped="Row_DoubleTapped"
                                          BorderBrush="{ThemeResource BorderBrush}" BorderThickness="0,1,0,0"
                                          ToolTipService.ToolTip="选中后在右侧查看方案；双击直接编辑">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Width="30" Height="30"
                                                Background="{ThemeResource InsetBrush}"
                                                BorderBrush="{ThemeResource BorderStrongBrush}" BorderThickness="1"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Initial}" FontSize="13" FontWeight="SemiBold"
                                                       FontFamily="{StaticResource MonoFontFamily}"
                                                       Foreground="{ThemeResource SubTextBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>

                                        <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center"
                                                    Margin="9,0,6,0">
                                            <TextBlock Text="{x:Bind Name}" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{ThemeResource TextBrush}" MaxLines="1"
                                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                            <TextBlock Style="{StaticResource TechCodeStyle}" TextWrapping="NoWrap"
                                                       TextTrimming="CharacterEllipsis">
                                                <Run Text="{x:Bind SourceText}" />
                                                <Run Text=" / " />
                                                <Run Text="{x:Bind StateText}" />
                                            </TextBlock>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2"
                                                    VerticalAlignment="Center">
                                            <Button Width="28" Height="28" Padding="0" Background="Transparent"
                                                    BorderThickness="0" CornerRadius="2"
                                                    Click="EditProfile_Click"
                                                    AutomationProperties.Name="编辑该游戏的启动方案"
                                                    ToolTipService.ToolTip="编辑该游戏的启动方案">
                                                <FontIcon Glyph="&#xE70F;" FontSize="12"
                                                          Foreground="{ThemeResource SubTextBrush}" />
                                            </Button>
                                            <Button Width="28" Height="28" Padding="0" Background="Transparent"
                                                    BorderThickness="0" CornerRadius="2"
                                                    Click="Start_Click"
                                                    AutomationProperties.Name="按该游戏方案启动"
                                                    ToolTipService.ToolTip="按该游戏方案启动">
                                                <FontIcon Glyph="&#xE768;" FontSize="12"
                                                          Foreground="{ThemeResource AccentBrush}" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <StackPanel x:Name="EmptyHint" VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Spacing="6" Visibility="Collapsed">
                            <TextBlock Text="NO LIBRARY" Style="{StaticResource TechLabelStyle}"
                                       Foreground="{ThemeResource DangerBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="没有检测到游戏" Style="{StaticResource SecondaryTextStyle}"
                                       TextAlignment="Center" />
                            <TextBlock Text="支持 Steam / Epic / WeGame / Xbox；也可以手动选择任意 exe。"
                                       Style="{StaticResource TechCodeStyle}" TextAlignment="Center"
                                       TextWrapping="Wrap" MaxWidth="260" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </controls:TechPanel>

            <!-- 右：选中游戏的方案与动作 -->
            <controls:TechPanel x:Name="DetailPanel" Grid.Column="1" Style="{StaticResource TechHeroStyle}"
                                Padding="24,20">
                <Grid>
                    <Grid x:Name="DetailContent" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" VerticalScrollMode="Auto"
                                      HorizontalContentAlignment="Stretch" Padding="0,0,6,0">
                            <StackPanel Spacing="0">
                                <Button x:Name="DetailBackButton" Content="返回游戏列表"
                                        Style="{StaticResource GhostButtonStyle}" Click="DetailBack_Click"
                                        Margin="0,0,0,10" Visibility="Collapsed" HorizontalAlignment="Left" />

                                <TextBlock Text="GAME // CONFIG" Style="{StaticResource TechLabelStyle}"
                                           Foreground="{ThemeResource AccentBrush}" />

                                <Grid ColumnSpacing="14" Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="58" Height="58"
                                            Background="{ThemeResource AccentSoftBrush}"
                                            BorderBrush="{ThemeResource HeroBorderBrush}" BorderThickness="1">
                                        <TextBlock x:Name="DetailMonogram" Text="?" FontSize="23" FontWeight="SemiBold"
                                                   FontFamily="{StaticResource MonoFontFamily}"
                                                   Foreground="{ThemeResource AccentBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                                        <TextBlock x:Name="DetailName" Text="游戏" FontSize="21" FontWeight="SemiBold"
                                                   Foreground="{ThemeResource TextBrush}" TextWrapping="Wrap"
                                                   MaxLines="2" TextTrimming="CharacterEllipsis" />
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Border Style="{StaticResource PillBorderStyle}">
                                                <TextBlock x:Name="DetailSource" Text="本地"
                                                           Style="{StaticResource TechCodeStyle}" />
                                            </Border>
                                            <Border Style="{StaticResource PillBorderStyle}">
                                                <TextBlock x:Name="DetailState" Text="可启动"
                                                           Style="{StaticResource TechCodeStyle}" />
                                            </Border>
                                            <Border x:Name="DetailManualPill" Style="{StaticResource PillBorderStyle}"
                                                    Visibility="Collapsed">
                                                <TextBlock Text="手动添加" Style="{StaticResource TechCodeStyle}" />
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>

                                <TextBlock x:Name="DetailPath" Text="—" Style="{StaticResource PathTextStyle}"
                                           Margin="0,14,0,0" MaxLines="2" TextWrapping="Wrap" />

                                <Border Height="1" Background="{ThemeResource BorderBrush}" Margin="0,16,0,0" />

                                <TextBlock Text="当前启动方案" Style="{StaticResource TechLabelStyle}"
                                           Margin="0,14,0,0" />
                                <controls:TechPanel Style="{StaticResource TechInsetStyle}" Margin="0,6,0,0" Padding="11,9">
                                    <TextBlock x:Name="DetailProfileText" Text="尚未保存方案"
                                               Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                                </controls:TechPanel>
                                <TextBlock x:Name="DetailProfileHint" Text="尚未保存专属方案，启动时使用系统默认策略。"
                                           Style="{StaticResource TechCodeStyle}" Margin="0,6,0,0"
                                           TextWrapping="Wrap" />

                                <Border Height="1" Background="{ThemeResource BorderBrush}" Margin="0,16,0,0" />

                                <TextBlock Text="启动设置" Style="{StaticResource TechLabelStyle}" Margin="0,14,0,0" />
                                <Grid ColumnSpacing="16" RowSpacing="12" Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="核心亲和" Style="{StaticResource TechCodeStyle}" />
                                        <TextBlock x:Name="DetailAffinityFact" Text="—" Style="{StaticResource BodyTextStyle}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="CPU 优先级" Style="{StaticResource TechCodeStyle}" />
                                        <TextBlock x:Name="DetailPriorityFact" Text="—" Style="{StaticResource BodyTextStyle}" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Spacing="2">
                                        <TextBlock Text="全屏独占" Style="{StaticResource TechCodeStyle}" />
                                        <TextBlock x:Name="DetailFsFact" Text="—" Style="{StaticResource BodyTextStyle}" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="1" Spacing="2">
                                        <TextBlock Text="高性能 GPU" Style="{StaticResource TechCodeStyle}" />
                                        <TextBlock x:Name="DetailGpuFact" Text="—" Style="{StaticResource BodyTextStyle}" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Spacing="2">
                                        <TextBlock Text="管理员启动" Style="{StaticResource TechCodeStyle}" />
                                        <TextBlock x:Name="DetailAdminFact" Text="—" Style="{StaticResource BodyTextStyle}" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock x:Name="DetailArgsLine" Text="启动参数：—"
                                           Style="{StaticResource TechCodeStyle}" Margin="0,10,0,0"
                                           TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </ScrollViewer>

                        <StackPanel Grid.Row="1" Spacing="10" Margin="0,14,0,0">
                            <Border Height="1" Background="{ThemeResource BorderBrush}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="DetailLaunchButton" Content="启动游戏"
                                        Style="{StaticResource AccentButtonStyle}" Click="DetailLaunch_Click" />
                                <Button x:Name="DetailEditButton" Content="编辑方案"
                                        Style="{StaticResource SubtleButtonStyle}" Click="DetailEdit_Click" />
                                <Button x:Name="DetailFolderButton" Content="打开目录"
                                        Style="{StaticResource GhostButtonStyle}" Click="DetailFolder_Click"
                                        ToolTipService.ToolTip="在资源管理器中定位该游戏的可执行文件" />
                                <Button x:Name="DetailRemoveButton" Content="从库移除"
                                        Style="{StaticResource DangerGhostButtonStyle}" Click="DetailRemove_Click"
                                        Visibility="Collapsed" />
                            </StackPanel>

                            <TextBlock x:Name="DetailFooterHint"
                                       Text="方案仅对该游戏生效。修改前会记录原值，可在「备份还原」中恢复系统设置。"
                                       Style="{StaticResource TechCodeStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>

                    <StackPanel x:Name="DetailEmpty" VerticalAlignment="Center" HorizontalAlignment="Center"
                                Spacing="8" MaxWidth="340">
                        <TextBlock Text="NO TARGET" Style="{StaticResource TechLabelStyle}"
                                   Foreground="{ThemeResource AccentBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="选择左侧的游戏" Style="{StaticResource BodyTextStyle}"
                                   FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Text="选中后会显示它的启动方案、路径与快捷操作。双击列表项可直接编辑。"
                                   Style="{StaticResource SecondaryTextStyle}" TextAlignment="Center" />
                        <Button Content="手动添加游戏" Style="{StaticResource SubtleButtonStyle}"
                                Click="AddGame_Click" Margin="0,4,0,0" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </controls:TechPanel>
        </Grid>
    </Grid>
</Page>
