<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="GamePerfCenter.Pages.GamesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:GamePerfCenter.Models"
    NavigationCacheMode="Required"
    Background="Transparent">

    <Grid Padding="28,24,28,20" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel Spacing="5">
                <TextBlock Text="GAME LIBRARY · PER-TITLE PROFILE" Style="{StaticResource EyebrowTextStyle}" />
                <TextBlock Text="游戏库" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="为单个游戏保存专属启动方案 · 不修改全局设置"
                           Style="{StaticResource SecondaryTextStyle}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="8">
                <Button Content="手动添加" Style="{StaticResource SubtleButtonStyle}" Click="AddGame_Click"
                        ToolTipService.ToolTip="选择任意 exe 加入游戏库" />
                <Button Content="重新扫描" Style="{StaticResource AccentButtonStyle}" Click="Scan_Click" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="14">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SearchBox" PlaceholderText="搜索游戏名称或路径..." MinHeight="34"
                         TextChanged="SearchBox_TextChanged" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock x:Name="CountText" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
                    <Button Content="打开游戏目录" Style="{StaticResource GhostButtonStyle}" Click="OpenGameDir_Click"
                            ToolTipService.ToolTip="先在列表中选中一个游戏" />
                </StackPanel>
            </Grid>
        </Border>

        <InfoBar x:Name="PageInfo" Grid.Row="2" IsOpen="False" IsClosable="True" />

        <Border Grid.Row="3" Style="{StaticResource CardBorderStyle}" Padding="10">
            <Grid>
                <ListView x:Name="GameList" SelectionMode="Single"
                          ItemContainerStyle="{StaticResource CardListViewItemStyle}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:GameInfo">
                            <Border Background="{ThemeResource Surface2Brush}" BorderBrush="{ThemeResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="12" Padding="16,13" Margin="0,0,0,8">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Width="42" Height="42" CornerRadius="11" VerticalAlignment="Center"
                                            Background="{ThemeResource AccentSoftBrush}">
                                        <FontIcon Glyph="&#xE7FC;" FontSize="18" Foreground="{ThemeResource AccentBrush}" />
                                    </Border>

                                    <StackPanel Grid.Column="1" Spacing="5" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{x:Bind Name}" FontSize="14.5" FontWeight="SemiBold"
                                                       Foreground="{ThemeResource TextBrush}" TextTrimming="CharacterEllipsis" />
                                            <Border Style="{StaticResource PillBorderStyle}" Padding="7,1">
                                                <TextBlock Text="{x:Bind SourceText}" Style="{StaticResource CaptionTextStyle}" />
                                            </Border>
                                            <Border Style="{StaticResource PillBorderStyle}" Padding="7,1">
                                                <TextBlock Text="{x:Bind StateText}" Style="{StaticResource CaptionTextStyle}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind Exe}" Style="{StaticResource MonoTextStyle}" FontSize="11.5"
                                                   TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Exe}" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE73E;" FontSize="11" Foreground="{ThemeResource Accent2Brush}"
                                                      VerticalAlignment="Center" />
                                            <TextBlock Text="{x:Bind ProfileText}" Style="{StaticResource CaptionTextStyle}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                                                VerticalAlignment="Center">
                                        <Button Content="移除" Style="{StaticResource GhostButtonStyle}" Click="Remove_Click"
                                                Visibility="{x:Bind Manual, Converter={StaticResource BoolVisible}}"
                                                ToolTipService.ToolTip="仅删除游戏库条目，不删除游戏文件" />
                                        <Button Content="方案" Style="{StaticResource GhostButtonStyle}" Click="Profile_Click" />
                                        <Button Content="应用" Style="{StaticResource SubtleButtonStyle}" Click="Apply_Click"
                                                ToolTipService.ToolTip="立即应用该游戏的专属设置" />
                                        <Button Content="启动" Style="{StaticResource AccentButtonStyle}" Click="Start_Click" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <StackPanel x:Name="EmptyHint" VerticalAlignment="Center" HorizontalAlignment="Center"
                            Spacing="9" Visibility="Collapsed">
                    <FontIcon Glyph="&#xE7FC;" FontSize="32" Foreground="{ThemeResource MutedTextBrush}" />
                    <TextBlock Text="没有检测到游戏" Style="{StaticResource SecondaryTextStyle}" />
                    <TextBlock Text="支持 Steam / Epic / Xbox 与手动添加的 exe" Style="{StaticResource CaptionTextStyle}" />
                    <Button Content="手动添加游戏" Style="{StaticResource SubtleButtonStyle}" Click="AddGame_Click"
                            Margin="0,4,0,0" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
