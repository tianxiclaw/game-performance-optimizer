<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="GamePerfCenter.Pages.GamesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:GamePerfCenter.Models"
    NavigationCacheMode="Required"
    Background="Transparent">

    <Grid Padding="28,24,28,20" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="10">
            <StackPanel Spacing="5">
                <TextBlock Text="GAME LIBRARY · PER-TITLE PROFILE" Style="{StaticResource EyebrowTextStyle}" />
                <TextBlock Text="游戏库" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="自动识别 Steam / Epic / WeGame 游戏，为每个游戏单独保存启动方案"
                           Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="手动添加" Style="{StaticResource SubtleButtonStyle}" Click="AddGame_Click"
                        ToolTipService.ToolTip="选择任意 exe 加入游戏库" />
                <Button x:Name="EditSelectedButton" Content="编辑方案" Style="{StaticResource GhostButtonStyle}"
                        Click="EditSelected_Click" IsEnabled="False"
                        ToolTipService.ToolTip="编辑并保存当前选中游戏的启动方案" />
                <Button Content="重新扫描" Style="{StaticResource AccentButtonStyle}" Click="Scan_Click" />
            </StackPanel>
        </StackPanel>

        <InfoBar x:Name="PageInfo" Grid.Row="1" IsOpen="False" IsClosable="True" />

        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="14">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SearchBox" PlaceholderText="搜索游戏名称或路径..." MinHeight="34"
                         TextChanged="SearchBox_TextChanged" />
                <TextBlock x:Name="CountText" Grid.Column="1" Style="{StaticResource CaptionTextStyle}"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource CardBorderStyle}" Padding="10">
            <Grid>
                <ListView x:Name="GameList" SelectionMode="Single"
                          SelectionChanged="GameList_SelectionChanged"
                          ItemContainerStyle="{StaticResource CardListViewItemStyle}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:GameInfo">
                            <Border Background="{ThemeResource Surface2Brush}" BorderBrush="{ThemeResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="12" Padding="14,12" Margin="0,0,0,8"
                                    DoubleTapped="Row_DoubleTapped">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Width="38" Height="38" CornerRadius="10" VerticalAlignment="Center"
                                            Background="{ThemeResource AccentSoftBrush}">
                                        <FontIcon Glyph="&#xE7FC;" FontSize="16" Foreground="{ThemeResource AccentBrush}" />
                                    </Border>

                                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                        <Grid ColumnSpacing="7">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind Name}" FontSize="14" FontWeight="SemiBold"
                                                       Foreground="{ThemeResource TextBrush}" TextTrimming="CharacterEllipsis" />
                                            <Border Grid.Column="1" Style="{StaticResource PillBorderStyle}" Padding="7,1">
                                                <TextBlock Text="{x:Bind SourceText}" Style="{StaticResource CaptionTextStyle}" />
                                            </Border>
                                            <Border Grid.Column="2" Style="{StaticResource PillBorderStyle}" Padding="7,1">
                                                <TextBlock Text="{x:Bind StateText}" Style="{StaticResource CaptionTextStyle}" />
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="{x:Bind Exe}" Style="{StaticResource MonoTextStyle}" FontSize="11"
                                                   TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Exe}" />
                                        <TextBlock Text="{x:Bind ProfileText}" Style="{StaticResource CaptionTextStyle}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6"
                                                VerticalAlignment="Center">
                                        <Button Content="编辑" Style="{StaticResource GhostButtonStyle}"
                                                Click="EditProfile_Click"
                                                ToolTipService.ToolTip="编辑并保存该游戏的启动方案" />
                                        <Button Content="启动" Style="{StaticResource SubtleButtonStyle}" Click="Start_Click" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <StackPanel x:Name="EmptyHint" VerticalAlignment="Center" HorizontalAlignment="Center"
                            Spacing="9" Visibility="Collapsed">
                    <FontIcon Glyph="&#xE7FC;" FontSize="32" Foreground="{ThemeResource MutedTextBrush}" />
                    <TextBlock Text="没有检测到游戏" Style="{StaticResource SecondaryTextStyle}" />
                    <TextBlock Text="支持 Steam / Epic / WeGame / Xbox 与手动添加的 exe"
                               Style="{StaticResource CaptionTextStyle}" TextAlignment="Center" TextWrapping="Wrap" />
                    <Button Content="手动添加游戏" Style="{StaticResource SubtleButtonStyle}" Click="AddGame_Click"
                            Margin="0,4,0,0" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
