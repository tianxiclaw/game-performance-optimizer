<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="GamePerfCenter.Pages.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Required"
    Background="Transparent">

    <Grid Padding="28,24,28,20" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock Text="关于与支持" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="这是什么、是否可信：版本、能力范围与支持作者的方式。"
                       Style="{StaticResource SecondaryTextStyle}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,4,8"
                      HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
                      HorizontalContentAlignment="Stretch">
            <StackPanel Spacing="16" MaxWidth="1500" HorizontalAlignment="Stretch">

                <Border Style="{StaticResource HeroBorderStyle}">
                    <Grid x:Name="HeroGrid" ColumnSpacing="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Background="{ThemeResource Surface2Brush}" CornerRadius="16" Padding="4"
                                VerticalAlignment="Center">
                            <Image x:Name="AppIcon" Width="64" Height="64" />
                        </Border>

                        <StackPanel Grid.Column="1" Spacing="7" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="游戏性能优化中心" Style="{StaticResource SectionTitleStyle}" />
                                <Border Style="{StaticResource PillBorderStyle}" Padding="9,2">
                                    <TextBlock x:Name="VersionBadge" Text="v6.0.0" Style="{StaticResource CaptionTextStyle}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="面向 Windows 的游戏性能调优与系统状态核查工具。所有优化均记录原值，支持一键回滚；数据只在本机采集，不联网、不上传。"
                                       Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" MaxWidth="820" />
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                                <Button Content="GitHub 主页" Style="{StaticResource SubtleButtonStyle}" Click="OpenRepo_Click" />
                                <Button Content="最新版本" Style="{StaticResource GhostButtonStyle}" Click="OpenReleases_Click" />
                                <Button Content="问题反馈" Style="{StaticResource GhostButtonStyle}" Click="OpenIssues_Click" />
                                <Button Content="使用说明" Style="{StaticResource GhostButtonStyle}" Click="OpenReadme_Click" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel x:Name="ClaimPanel" Grid.Column="2" Spacing="6" VerticalAlignment="Center" MinWidth="150">
                            <StackPanel Orientation="Horizontal" Spacing="7" HorizontalAlignment="Right">
                                <FontIcon Glyph="&#xE72E;" FontSize="13" Foreground="{ThemeResource SubTextBrush}" />
                                <TextBlock Text="仅本机运行" Style="{StaticResource CaptionTextStyle}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="7" HorizontalAlignment="Right">
                                <FontIcon Glyph="&#xE777;" FontSize="13" Foreground="{ThemeResource SubTextBrush}" />
                                <TextBlock Text="改动可还原" Style="{StaticResource CaptionTextStyle}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="7" HorizontalAlignment="Right">
                                <FontIcon Glyph="&#xE8C8;" FontSize="13" Foreground="{ThemeResource SubTextBrush}" />
                                <TextBlock Text="无广告无捆绑" Style="{StaticResource CaptionTextStyle}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 支持作者：商业化入口，必须始终可见 -->
                    <Border x:Name="SupportCard" Style="{StaticResource CardBorderStyle}">
                        <Grid ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Spacing="8" VerticalAlignment="Center">
                                <Border Background="{ThemeResource QrPanelBrush}" CornerRadius="12" Padding="10"
                                        BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1">
                                    <Image x:Name="SupportQr" Width="132" Height="132"
                                           Stretch="Uniform" Tapped="SupportQr_Tapped"
                                           ToolTipService.ToolTip="点击放大" />
                                </Border>
                                <TextBlock Text="点击赞赏码可放大" Style="{StaticResource CaptionTextStyle}"
                                           HorizontalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Spacing="10" VerticalAlignment="Center">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="支持作者" Style="{StaticResource SectionTitleStyle}" />
                                    <TextBlock Text="如果这个工具帮你省下了折腾的时间，欢迎请我喝杯咖啡。"
                                               Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                                </StackPanel>
                                <TextBlock Text="你的支持会用于持续维护优化项、适配新硬件与修复兼容性问题。完全自愿，不影响任何功能。"
                                           Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="放大查看" Style="{StaticResource AccentButtonStyle}"
                                            Click="EnlargeQr_Click" />
                                    <Button Content="打开原图" Style="{StaticResource SubtleButtonStyle}"
                                            Click="OpenQrOriginal_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border x:Name="CapabilityCard" Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="能力范围" Style="{StaticResource SectionTitleStyle}" />
                            <ItemsControl x:Name="CapabilityList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,10">
                                            <FontIcon Glyph="&#xE73E;" FontSize="12" Foreground="{ThemeResource SubTextBrush}"
                                                      VerticalAlignment="Top" Margin="0,2,0,0" />
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                           Foreground="{ThemeResource TextBrush}" />
                                                <TextBlock Text="{Binding Desc}" Style="{StaticResource CaptionTextStyle}"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border Style="{StaticResource DividerStyle}" Margin="0,2,0,0" />
                            <TextBlock Text="优化效果因硬件、系统版本与游戏而异。涉及注册表与服务的改动均在应用前自动备份，可在“备份还原”中回滚。"
                                       Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>

                <TextBlock Text="© 2026 游戏性能优化中心 · 本工具与 NVIDIA、AMD、Intel、Microsoft 无隶属关系"
                           Style="{StaticResource CaptionTextStyle}" HorizontalAlignment="Center" Margin="0,6,0,4" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
