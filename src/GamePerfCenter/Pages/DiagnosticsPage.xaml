<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="GamePerfCenter.Pages.DiagnosticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:GamePerfCenter.Models"
    NavigationCacheMode="Required"
    Background="Transparent">

    <Grid Padding="28,24,28,20" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="10">
            <StackPanel Spacing="4">
                <TextBlock Text="诊断报告" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="当前有哪些风险：硬件、电源、驱动、服务与安全状态的一次性核查。"
                           Style="{StaticResource SecondaryTextStyle}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6">
                <Button Content="打开诊断目录" Style="{StaticResource GhostButtonStyle}" Click="OpenFolder_Click" />
                <Button Content="导出诊断包" Style="{StaticResource SubtleButtonStyle}" Click="ExportBundle_Click"
                        ToolTipService.ToolTip="打包日志、配置与诊断文本，便于反馈问题" />
                <Button Content="导出报告" Style="{StaticResource SubtleButtonStyle}" Click="ExportReport_Click" />
                <Button Content="重新诊断" Style="{StaticResource AccentButtonStyle}" Click="Run_Click" />
            </StackPanel>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="16,12">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="38" Height="38" CornerRadius="10" Background="{ThemeResource AccentSoftBrush}"
                        VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE9D9;" FontSize="16" Foreground="{ThemeResource AccentBrush}" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                    <TextBlock x:Name="LastExportTitle" Text="尚未导出" Style="{StaticResource BodyTextStyle}" />
                    <TextBlock x:Name="LastExportPath" Text="导出的报告会保存在 diagnostics 目录"
                               Style="{StaticResource CaptionTextStyle}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button x:Name="OpenExportButton" Grid.Column="2" Content="打开文件" Style="{StaticResource GhostButtonStyle}"
                        Click="OpenExport_Click" IsEnabled="False" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <InfoBar x:Name="PageInfo" Grid.Row="2" IsOpen="False" IsClosable="True" />

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Padding="0,0,4,8"
                      HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
                      HorizontalContentAlignment="Stretch">
            <StackPanel Spacing="14" MaxWidth="1500" HorizontalAlignment="Stretch">
                <ItemsControl x:Name="GroupList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:DiagGroup">
                            <Border Style="{StaticResource CardBorderStyle}">
                                <StackPanel Spacing="12">
                                    <Grid>
                                        <TextBlock Text="{x:Bind Name}" Style="{StaticResource SectionTitleStyle}" />
                                        <TextBlock Text="{x:Bind Hint}" HorizontalAlignment="Right"
                                                   Style="{StaticResource CaptionTextStyle}" />
                                    </Grid>
                                    <ItemsControl ItemsSource="{x:Bind Items}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:DiagEntry">
                                                <Grid ColumnSpacing="14" Margin="0,0,0,9">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="190" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{x:Bind Name}" Style="{StaticResource SecondaryTextStyle}" />
                                                    <StackPanel Grid.Column="1" Spacing="2">
                                                        <TextBlock Text="{x:Bind Value}" Style="{StaticResource BodyTextStyle}"
                                                                   TextWrapping="Wrap" />
                                                        <TextBlock Text="{x:Bind Hint}" Style="{StaticResource CaptionTextStyle}"
                                                                   TextWrapping="Wrap"
                                                                   Visibility="{x:Bind Hint, Converter={StaticResource NullVisible}}" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" Text="{x:Bind LevelText}"
                                                               Foreground="{x:Bind Level, Converter={StaticResource LevelBrush}}"
                                                               FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Top"
                                                               Margin="0,1,0,0" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel x:Name="EmptyHint" Spacing="9" HorizontalAlignment="Center" Margin="0,60"
                            Visibility="Collapsed">
                    <FontIcon Glyph="&#xE9D9;" FontSize="32" Foreground="{ThemeResource MutedTextBrush}" />
                    <TextBlock Text="还没有诊断结果" Style="{StaticResource SecondaryTextStyle}" />
                    <Button Content="开始诊断" Style="{StaticResource AccentButtonStyle}" Click="Run_Click" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
