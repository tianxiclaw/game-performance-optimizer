<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="GamePerfCenter.Pages.ItemsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:GamePerfCenter.Controls"
    xmlns:models="using:GamePerfCenter.Models"
    NavigationCacheMode="Required"
    Background="Transparent">

    <Grid x:Name="RootGrid" Padding="24,18,24,18" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <controls:PageHeader Title="优化项"
                             Subtitle="哪些项值得改：勾选后预览或应用，所有改动都记录原值、可还原。">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Button Content="全选推荐" Style="{StaticResource SubtleButtonStyle}" Click="SelectRecommended_Click"
                        ToolTipService.ToolTip="选中所有待优化的低风险项目" />
                <Button Content="清除选择" Style="{StaticResource GhostButtonStyle}" Click="ClearSelection_Click" />
                <Button Content="刷新状态" Style="{StaticResource GhostButtonStyle}" Click="Refresh_Click"
                        ToolTipService.ToolTip="重新检测全部优化项" />
            </StackPanel>
        </controls:PageHeader>

        <!-- 筛选条：过滤条件与结果计数是同一件事，压成一条控制台 -->
        <controls:TechPanel x:Name="FilterPanel" Grid.Row="1" Style="{StaticResource TechCardStyle}"
                            Padding="14,12">
            <Grid x:Name="FilterGrid" ColumnSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox x:Name="SearchBox" PlaceholderText="搜索名称、分类或说明..."
                         TextChanged="SearchBox_TextChanged" MinHeight="32" />

                <ComboBox x:Name="CategoryBox" Grid.Column="1" PlaceholderText="全部分类"
                          SelectionChanged="Filter_Changed" MinHeight="32" MinWidth="132"
                          HorizontalAlignment="Stretch" />
                <ComboBox x:Name="RiskBox" Grid.Column="2" PlaceholderText="全部风险"
                          SelectionChanged="Filter_Changed" MinHeight="32" MinWidth="120"
                          HorizontalAlignment="Stretch" />
                <StackPanel x:Name="ProfileGroup" Grid.Column="3" Orientation="Horizontal" Spacing="6">
                    <ComboBox x:Name="ProfileBox" PlaceholderText="预设方案"
                              MinHeight="32" MinWidth="128" HorizontalAlignment="Stretch" />
                    <Button Content="载入" Style="{StaticResource SubtleButtonStyle}" Click="LoadProfile_Click"
                            ToolTipService.ToolTip="将方案中的项目设为选中" />
                    <Button Content="保存" Style="{StaticResource SubtleButtonStyle}" Click="SaveProfile_Click"
                            ToolTipService.ToolTip="把当前勾选项保存为自定义方案" />
                </StackPanel>

                <StackPanel x:Name="StatusRow" Grid.Row="1" Grid.ColumnSpan="4" Spacing="9"
                            Margin="0,10,0,0">
                <Border x:Name="FilterDivider" Height="1"
                        Background="{ThemeResource BorderBrush}" Opacity="0.7" />

                <Grid x:Name="CountsRow">
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <Rectangle Width="3" Height="10" Fill="{ThemeResource OkBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Name="AppliedChip" Text="已生效 0" Style="{StaticResource TechCodeStyle}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <Rectangle Width="3" Height="10" Fill="{ThemeResource WarnBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Name="PendingChip" Text="待优化 0" Style="{StaticResource TechCodeStyle}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <Rectangle Width="3" Height="10" Fill="{ThemeResource MutedTextBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Name="NaChip" Text="不适用 0" Style="{StaticResource TechCodeStyle}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <Rectangle Width="3" Height="10" Fill="{ThemeResource AccentBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Name="SelectedChip" Text="已选 0" Style="{StaticResource TechCodeStyle}"
                                       Foreground="{ThemeResource AccentBrush}" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock x:Name="ViewCountText" HorizontalAlignment="Right" VerticalAlignment="Center"
                               Style="{StaticResource TechCodeStyle}" />
                </Grid>
                </StackPanel>
            </Grid>
        </controls:TechPanel>

        <!-- 列表：表头用等宽微标签，行与行之间只有一条极细分割线 -->
        <controls:TechPanel x:Name="ListPanel" Grid.Row="2" Style="{StaticResource TechCardStyle}"
                            Padding="14,10,14,6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid ColumnSpacing="12" Padding="4,0,4,8" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="选择" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="优化项" Style="{StaticResource CaptionTextStyle}" />
                    <TextBlock Grid.Column="2" Text="状态" Style="{StaticResource CaptionTextStyle}"
                               HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="3" Text="操作" Style="{StaticResource CaptionTextStyle}" Margin="0,0,4,0" />
                </Grid>

                <ListView x:Name="ItemsList" Grid.Row="1" SelectionMode="None"
                          ItemContainerStyle="{StaticResource DenseListViewItemStyle}"
                          ItemsSource="{x:Bind View}" IsItemClickEnabled="False"
                          AutomationProperties.Name="优化项列表" Padding="0">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:ItemInfo">
                            <Grid BorderBrush="{ThemeResource BorderBrush}" BorderThickness="0,1,0,0"
                                  Tapped="Row_Tapped" RightTapped="Row_RightTapped">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- 主行：点击任意空白处展开，按钮与勾选框保持独立 -->
                                <Grid ColumnSpacing="12" Padding="4,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <CheckBox IsChecked="{x:Bind Selected, Mode=TwoWay}" Click="ItemCheck_Click"
                                              Style="{StaticResource SquareCheckBoxStyle}"
                                              VerticalAlignment="Center" HorizontalAlignment="Center"
                                              ToolTipService.ToolTip="勾选后预览或应用" />

                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{x:Bind Name}" FontSize="13.5" FontWeight="SemiBold"
                                                       Foreground="{ThemeResource TextBrush}" MaxLines="1"
                                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                                       ToolTipService.ToolTip="{x:Bind Name}" />
                                            <TextBlock Text="{x:Bind Id}" Style="{StaticResource TechCodeStyle}"
                                                       VerticalAlignment="Center" MaxLines="1"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="{x:Bind Cat}" FontSize="11.5"
                                                       Foreground="{ThemeResource SubTextBrush}" TextWrapping="NoWrap" />
                                            <TextBlock Text="·" FontSize="11.5"
                                                       Foreground="{ThemeResource FaintTextBrush}" TextWrapping="NoWrap" />
                                            <TextBlock Text="{x:Bind Risk, Converter={StaticResource RiskText}}"
                                                       FontSize="11.5"
                                                       Foreground="{x:Bind Risk, Converter={StaticResource RiskBrush}}"
                                                       TextWrapping="NoWrap" />
                                            <TextBlock Text="·" FontSize="11.5"
                                                       Foreground="{ThemeResource FaintTextBrush}" TextWrapping="NoWrap"
                                                       Visibility="{x:Bind NeedsReboot, Converter={StaticResource BoolVisible}}" />
                                            <TextBlock Text="需重启" FontSize="11.5"
                                                       Foreground="{ThemeResource WarnBrush}" TextWrapping="NoWrap"
                                                       Visibility="{x:Bind NeedsReboot, Converter={StaticResource BoolVisible}}" />
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource SecondaryTextStyle}"
                                                   MaxLines="1" TextTrimming="CharacterEllipsis"
                                                   ToolTipService.ToolTip="{x:Bind Desc}">
                                            <Run Text="{x:Bind Desc}" />
                                            <Run Text="  目标：" Foreground="{ThemeResource FaintTextBrush}" />
                                            <Run Text="{x:Bind Target}" Foreground="{ThemeResource SubTextBrush}" />
                                        </TextBlock>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Spacing="2" HorizontalAlignment="Right"
                                                VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                                            <Rectangle Width="3" Height="10" VerticalAlignment="Center"
                                                       Fill="{x:Bind Status, Converter={StaticResource StatusBrush}}" />
                                            <TextBlock Text="{x:Bind Status, Converter={StaticResource StatusText}}"
                                                       FontSize="12" FontWeight="SemiBold" TextWrapping="NoWrap"
                                                       Foreground="{x:Bind Status, Converter={StaticResource StatusBrush}}" />
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind StatusText}" Style="{StaticResource TechCodeStyle}"
                                                   TextAlignment="Right" MaxWidth="150" MaxLines="1"
                                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                                   ToolTipService.ToolTip="{x:Bind StatusText}" />
                                    </StackPanel>

                                    <Button Grid.Column="3" Style="{StaticResource SubtleButtonStyle}"
                                            Padding="9,4" MinHeight="28" VerticalAlignment="Center"
                                            Click="Expand_Click"
                                            AutomationProperties.Name="展开或收起该项详情"
                                            ToolTipService.ToolTip="展开原值、目标值、依赖与上次应用时间">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <TextBlock Text="{x:Bind ExpandLabel, Mode=OneWay}" FontSize="12" />
                                            <FontIcon Glyph="{x:Bind ExpandGlyph, Mode=OneWay}" FontSize="9" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <!-- 行内详情：不打断列表上下文，同时保留单项应用入口 -->
                                <Border Grid.Row="1" Padding="28,0,4,12" Tag="ItemDetail"
                                        Visibility="{x:Bind ExpandVisibility, Mode=OneWay}">
                                    <controls:TechPanel Style="{StaticResource TechInsetStyle}"
                                                        Padding="14,12" Radius="8">
                                        <StackPanel Spacing="10">
                                            <TextBlock Text="{x:Bind Desc}" FontSize="12.5"
                                                       Foreground="{ThemeResource SubTextBrush}"
                                                       TextWrapping="Wrap" LineHeight="19" />

                                            <Grid ColumnSpacing="20" RowSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <StackPanel Spacing="2">
                                                    <TextBlock Text="目标值" Style="{StaticResource TechMicroStyle}" />
                                                    <TextBlock Text="{x:Bind Target}" FontSize="12.5"
                                                               Foreground="{ThemeResource TextBrush}"
                                                               TextWrapping="Wrap" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Spacing="2">
                                                    <TextBlock Text="当前状态" Style="{StaticResource TechMicroStyle}" />
                                                    <TextBlock Text="{x:Bind StatusText}" FontSize="12.5"
                                                               Foreground="{ThemeResource TextBrush}"
                                                               TextWrapping="Wrap" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Spacing="2">
                                                    <TextBlock Text="风险" Style="{StaticResource TechMicroStyle}" />
                                                    <TextBlock Text="{x:Bind Risk, Converter={StaticResource RiskText}}"
                                                               FontSize="12.5"
                                                               Foreground="{x:Bind Risk, Converter={StaticResource RiskBrush}}" />
                                                </StackPanel>

                                                <StackPanel Grid.Row="1" Spacing="2">
                                                    <TextBlock Text="需要重启" Style="{StaticResource TechMicroStyle}" />
                                                    <TextBlock Text="{x:Bind RebootText}" FontSize="12.5"
                                                               Foreground="{ThemeResource SubTextBrush}" />
                                                </StackPanel>
                                                <StackPanel Grid.Row="1" Grid.Column="1" Spacing="2">
                                                    <TextBlock Text="依赖项" Style="{StaticResource TechMicroStyle}" />
                                                    <TextBlock Text="{x:Bind DependencyText}" FontSize="12.5"
                                                               Foreground="{ThemeResource SubTextBrush}"
                                                               TextWrapping="Wrap" />
                                                </StackPanel>
                                                <StackPanel Grid.Row="1" Grid.Column="2" Spacing="2">
                                                    <TextBlock Text="上次应用" Style="{StaticResource TechMicroStyle}" />
                                                    <TextBlock Text="{x:Bind LastAppliedText, Mode=OneWay}"
                                                               FontSize="12.5"
                                                               Foreground="{ThemeResource SubTextBrush}" />
                                                </StackPanel>
                                            </Grid>

                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{x:Bind Id}" Style="{StaticResource TechCodeStyle}"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                           TextWrapping="NoWrap" />
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                                                            HorizontalAlignment="Right">
                                                    <Button Content="复制 ID" Style="{StaticResource GhostButtonStyle}"
                                                            Padding="9,3" MinHeight="26" FontSize="11.5"
                                                            Click="CopyId_Click" />
                                                    <Button Content="应用此项" Style="{StaticResource AccentButtonStyle}"
                                                            Padding="11,3" MinHeight="26" FontSize="11.5"
                                                            Click="ApplyItem_Click" />
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </controls:TechPanel>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <StackPanel x:Name="EmptyHint" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                            Spacing="6" Visibility="Collapsed">
                    <TextBlock x:Name="EmptyTitle" Text="没有符合条件的优化项" Style="{StaticResource BodyTextStyle}"
                               HorizontalAlignment="Center" />
                    <TextBlock x:Name="EmptyDetail" Text="试试清空搜索词，或把分类、风险筛选恢复为全部。"
                               Style="{StaticResource CaptionTextStyle}" TextAlignment="Center"
                               TextWrapping="Wrap" MaxWidth="320" />
                </StackPanel>
            </Grid>
        </controls:TechPanel>

        <InfoBar x:Name="PageInfo" Grid.Row="3" IsOpen="False" IsClosable="True" Margin="0,0,0,2" />

        <!-- 操作栏 -->
        <controls:TechPanel x:Name="ActionPanel" Grid.Row="4" Style="{StaticResource TechCardStyle}"
                            Padding="14,10">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="1" VerticalAlignment="Center">
                    <TextBlock x:Name="ActionSummary" Text="未选择项目" Style="{StaticResource BodyTextStyle}"
                               FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                    <TextBlock x:Name="ActionHint" Text="应用前自动生成原值备份 · 预览不会写入系统"
                               Style="{StaticResource TechCodeStyle}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Button Content="恢复最近备份" Style="{StaticResource DangerGhostButtonStyle}" Click="RestoreLatest_Click"
                            ToolTipService.ToolTip="撤销最近一次应用，会覆盖当前对应的系统设置" />
                    <Button x:Name="PreviewButton" Content="预览所选" Style="{StaticResource SubtleButtonStyle}"
                            Click="PreviewSelected_Click" />
                    <Button x:Name="ApplyButton" Content="应用所选" Style="{StaticResource AccentButtonStyle}"
                            Click="ApplySelected_Click" />
                </StackPanel>
            </Grid>
        </controls:TechPanel>
    </Grid>
</Page>
