<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="GamePerfCenter.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:GamePerfCenter.Controls"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" Background="{ThemeResource AppBackdropBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="*" />
            <RowDefinition Height="94" />
        </Grid.RowDefinitions>

        <!-- 材质高光层：只服务于云母 / 液态玻璃，深空模式隐藏 -->
        <Border x:Name="SheenLayer" Grid.RowSpan="3" IsHitTestVisible="False" Opacity="0" />

        <!-- 顶栏：品牌、当前位置与全局操作；导航已下放到底部 Dock -->
        <Grid x:Name="TitleBarDrag" Grid.Row="0" Background="{ThemeResource PaneBrush}"
              Padding="16,0,150,0" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Grid.ColumnSpan="2" Height="1" VerticalAlignment="Bottom"
                    Margin="-16,0,-150,0" Background="{ThemeResource BorderBrush}"
                    Opacity="0.7" IsHitTestVisible="False" />

            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <controls:TechPanel x:Name="BrandMark" Width="30" Height="30" Radius="9"
                                    Fill="{ThemeResource AccentSoftBrush}"
                                    Stroke="{ThemeResource AccentBrush}" StrokeThickness="1"
                                    VerticalAlignment="Center">
                    <TextBlock Text="GP" FontFamily="{StaticResource AppFontFamily}" FontSize="11"
                               FontWeight="SemiBold" Foreground="{ThemeResource AccentBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </controls:TechPanel>
                <StackPanel x:Name="BrandText" Spacing="1" VerticalAlignment="Center">
                    <TextBlock Text="游戏性能优化中心" FontFamily="{StaticResource DisplayFontFamily}"
                               FontSize="13.5" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextBrush}" TextWrapping="NoWrap" />
                    <TextBlock Text="本机调优工作台" Style="{StaticResource CaptionTextStyle}" />
                </StackPanel>
                <Border Width="1" Height="18" Background="{ThemeResource BorderBrush}" Opacity="0.8"
                        VerticalAlignment="Center" />
                <Grid VerticalAlignment="Center" ColumnSpacing="7">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="CrumbRoot" Text="工作台" Style="{StaticResource TechLabelStyle}" />
                    <TextBlock x:Name="CrumbSlash" Grid.Column="1" Text="/"
                               Style="{StaticResource TechLabelStyle}"
                               Foreground="{ThemeResource FaintTextBrush}" />
                    <TextBlock x:Name="TopBreadcrumb" Grid.Column="2" Text="概览"
                               Style="{StaticResource TechLabelStyle}"
                               Foreground="{ThemeResource TextBrush}" TextWrapping="NoWrap" MaxLines="1"
                               TextTrimming="CharacterEllipsis" />
                </Grid>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Spacing="8">
                <!-- 待优化：折叠成一枚感叹号，悬浮放大并列出具体项目 -->
                <Button x:Name="PendingButton" Click="PendingButton_Click" Visibility="Collapsed"
                        Width="32" Height="32" Padding="0" CornerRadius="16"
                        Background="Transparent" BorderThickness="0"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="待优化项">
                    <Grid Width="24" Height="24">
                        <Ellipse Fill="{ThemeResource WarnSoftBrush}" />
                        <StackPanel Spacing="2.2" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Rectangle Width="2.6" Height="8" RadiusX="1.3" RadiusY="1.3"
                                       Fill="{ThemeResource WarnBrush}" />
                            <Ellipse Width="2.6" Height="2.6" Fill="{ThemeResource WarnBrush}" />
                        </StackPanel>
                    </Grid>
                </Button>

                <!-- 工具组：主题 / 语言 / 控制台 / 项目主页收进同一胶囊，
                     顶栏只留“通知 + 工具”两组，不再散落成一排图标。 -->
                <Border Background="{ThemeResource InsetBrush}" BorderBrush="{ThemeResource BorderBrush}"
                        BorderThickness="1" CornerRadius="9" Padding="2" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="1">
                        <Button x:Name="ThemeLightButton" Tag="light" Click="ThemeSegment_Click"
                                Style="{StaticResource ThemeIconButtonStyle}" VerticalAlignment="Center"
                                AutomationProperties.Name="浅色主题"
                                ToolTipService.ToolTip="浅色主题">
                            <FontIcon Glyph="&#xE706;" FontSize="13" />
                        </Button>
                        <Button x:Name="ThemeDarkButton" Tag="dark" Click="ThemeSegment_Click"
                                Style="{StaticResource ThemeIconButtonStyle}" VerticalAlignment="Center"
                                AutomationProperties.Name="深色主题"
                                ToolTipService.ToolTip="深色主题">
                            <FontIcon Glyph="&#xE708;" FontSize="13" />
                        </Button>
                        <Button x:Name="ThemeSystemButton" Tag="system" Click="ThemeSegment_Click"
                                Style="{StaticResource ThemeIconButtonStyle}" VerticalAlignment="Center"
                                AutomationProperties.Name="跟随系统"
                                ToolTipService.ToolTip="跟随系统">
                            <FontIcon Glyph="&#xE7F4;" FontSize="13" />
                        </Button>

                        <Border Width="1" Height="16" Margin="4,0" Background="{ThemeResource BorderBrush}"
                                Opacity="0.8" VerticalAlignment="Center" />

                        <Button x:Name="LanguageButton" Style="{StaticResource IconButtonStyle}"
                                Click="LanguageButton_Click" VerticalAlignment="Center"
                                AutomationProperties.Name="切换到英文界面"
                                ToolTipService.ToolTip="界面语言：中文（点击切换到 English）">
                            <FontIcon Glyph="&#xE8C1;" FontSize="14" />
                        </Button>

                        <Button x:Name="InspectorToggleButton" Style="{StaticResource IconButtonStyle}"
                                Click="InspectorToggle_Click" VerticalAlignment="Center"
                                AutomationProperties.Name="展开控制台"
                                ToolTipService.ToolTip="展开右侧控制台：实时负载、待办与快捷操作">
                            <FontIcon Glyph="&#xE8A1;" FontSize="14" />
                        </Button>

                        <Border Width="1" Height="16" Margin="4,0" Background="{ThemeResource BorderBrush}"
                                Opacity="0.8" VerticalAlignment="Center" />

                        <Button x:Name="RepoButton" Style="{StaticResource IconButtonStyle}"
                                ToolTipService.ToolTip="打开项目主页"
                                Click="RepoButton_Click" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE774;" FontSize="14" />
                        </Button>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- 内容区：单列铺满，右侧控制台以抽屉形式覆盖 -->
        <Grid Grid.Row="1">
            <Canvas x:Name="StarLayer" IsHitTestVisible="False" />
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <InfoBar x:Name="EngineInfoBar" Grid.Row="0" IsOpen="False" Severity="Error"
                         Visibility="Collapsed" Margin="22,12,22,0" Title="引擎错误" IsClosable="True" />
                <Frame x:Name="ContentFrame" Grid.Row="1" Background="Transparent" />
            </Grid>

            <!-- 右侧控制台：默认收起，展开时不挤压页面，覆盖在内容上方 -->
            <Border x:Name="InspectorPanel" Width="320" HorizontalAlignment="Right"
                    VerticalAlignment="Stretch" Visibility="Collapsed" Opacity="0"
                    Background="{ThemeResource DrawerSurfaceBrush}"
                    BorderBrush="{ThemeResource BorderStrongBrush}" BorderThickness="1,0,0,0">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="InspectorSlide" X="24" />
                </Border.RenderTransform>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Padding="18,16,12,12" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="3">
                            <TextBlock Text="控制台" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="实时状态与快捷入口" Style="{StaticResource SecondaryTextStyle}" />
                        </StackPanel>
                        <Button x:Name="InspectorCloseButton" Grid.Column="1"
                                Style="{StaticResource IconButtonStyle}" VerticalAlignment="Top"
                                Click="InspectorClose_Click"
                                AutomationProperties.Name="收起控制台"
                                ToolTipService.ToolTip="收起控制台">
                            <FontIcon Glyph="&#xE711;" FontSize="12" />
                        </Button>
                    </Grid>

                    <ScrollViewer Grid.Row="1" Padding="18,0,18,18"
                                  VerticalScrollBarVisibility="Auto" VerticalScrollMode="Auto">
                        <StackPanel Spacing="16">
                            <!-- 本机身份 -->
                            <StackPanel Spacing="6">
                                <TextBlock Text="本机" Style="{StaticResource CaptionTextStyle}" />
                                <TextBlock x:Name="PaneDeviceName" Text="正在识别本机" FontSize="14"
                                           FontWeight="SemiBold" Foreground="{ThemeResource TextBrush}"
                                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Ellipse x:Name="PaneEngineDot" Width="5" Height="5"
                                             VerticalAlignment="Center" Fill="{ThemeResource WarnBrush}" />
                                    <TextBlock x:Name="PaneEngineText" Text="正在连接优化引擎" FontSize="11.5"
                                               Foreground="{ThemeResource SubTextBrush}" TextWrapping="NoWrap"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </StackPanel>

                            <Border Height="1" Background="{ThemeResource BorderBrush}" Opacity="0.65" />

                            <!-- 实时负载 -->
                            <StackPanel Spacing="8">
                                <Grid>
                                    <TextBlock Text="实时负载" Style="{StaticResource CaptionTextStyle}" />
                                    <TextBlock Text="每 2 秒" Style="{StaticResource CaptionTextStyle}"
                                               HorizontalAlignment="Right" />
                                </Grid>
                                <StackPanel Spacing="3">
                                    <Grid>
                                        <TextBlock Text="CPU" Style="{StaticResource CaptionTextStyle}" />
                                        <TextBlock x:Name="PaneCpuValue" Text="--" HorizontalAlignment="Right"
                                                   Style="{StaticResource MonoTextStyle}" FontSize="10.5" />
                                    </Grid>
                                    <ProgressBar x:Name="PaneCpuBar" Minimum="0" Maximum="100" Height="2"
                                                 Foreground="{ThemeResource AccentBrush}"
                                                 Background="{ThemeResource Surface2Brush}" />
                                </StackPanel>
                                <StackPanel Spacing="3">
                                    <Grid>
                                        <TextBlock Text="GPU" Style="{StaticResource CaptionTextStyle}" />
                                        <TextBlock x:Name="PaneGpuValue" Text="--" HorizontalAlignment="Right"
                                                   Style="{StaticResource MonoTextStyle}" FontSize="10.5" />
                                    </Grid>
                                    <ProgressBar x:Name="PaneGpuBar" Minimum="0" Maximum="100" Height="2"
                                                 Foreground="{ThemeResource AccentBrush}"
                                                 Background="{ThemeResource Surface2Brush}" />
                                </StackPanel>
                                <StackPanel Spacing="3">
                                    <Grid>
                                        <TextBlock Text="内存" Style="{StaticResource CaptionTextStyle}" />
                                        <TextBlock x:Name="PaneRamValue" Text="--" HorizontalAlignment="Right"
                                                   Style="{StaticResource MonoTextStyle}" FontSize="10.5" />
                                    </Grid>
                                    <ProgressBar x:Name="PaneRamBar" Minimum="0" Maximum="100" Height="2"
                                                 Foreground="{ThemeResource AccentBrush}"
                                                 Background="{ThemeResource Surface2Brush}" />
                                </StackPanel>
                            </StackPanel>

                            <Border Height="1" Background="{ThemeResource BorderBrush}" Opacity="0.65" />

                            <!-- 待办 -->
                            <StackPanel Spacing="8">
                                <TextBlock Text="待应用" Style="{StaticResource CaptionTextStyle}" />
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="DrawerPendingText" Text="—" FontSize="14"
                                               FontWeight="SemiBold" Foreground="{ThemeResource TextBrush}"
                                               VerticalAlignment="Center" />
                                    <Button x:Name="DrawerPendingButton" Grid.Column="1" Content="查看"
                                            Style="{StaticResource SubtleButtonStyle}" Padding="12,5"
                                            MinHeight="30" Click="PendingButton_Click" />
                                </Grid>
                            </StackPanel>

                            <!-- 快捷操作 -->
                            <StackPanel Spacing="8">
                                <TextBlock Text="快捷操作" Style="{StaticResource CaptionTextStyle}" />
                                <Grid ColumnSpacing="8" RowSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Button Content="命令面板" Style="{StaticResource SubtleButtonStyle}"
                                            Padding="10,6" MinHeight="32" HorizontalAlignment="Stretch"
                                            Click="CommandButton_Click" />
                                    <Button Grid.Column="1" Content="刷新状态"
                                            Style="{StaticResource SubtleButtonStyle}"
                                            Padding="10,6" MinHeight="32" HorizontalAlignment="Stretch"
                                            Click="DrawerRefresh_Click" />
                                    <Button Grid.Row="1" Content="数据目录"
                                            Style="{StaticResource SubtleButtonStyle}"
                                            Padding="10,6" MinHeight="32" HorizontalAlignment="Stretch"
                                            Click="DrawerDataDir_Click" />
                                    <Button Grid.Row="1" Grid.Column="1" Content="备份目录"
                                            Style="{StaticResource SubtleButtonStyle}"
                                            Padding="10,6" MinHeight="32" HorizontalAlignment="Stretch"
                                            Click="DrawerBackupDir_Click" />
                                </Grid>
                            </StackPanel>

                            <Border Height="1" Background="{ThemeResource BorderBrush}" Opacity="0.65" />

                            <!-- 当前页面 -->
                            <StackPanel Spacing="5">
                                <TextBlock Text="当前页面" Style="{StaticResource CaptionTextStyle}" />
                                <TextBlock x:Name="DrawerPageTitle" Text="概览" FontSize="13.5"
                                           FontWeight="SemiBold" Foreground="{ThemeResource TextBrush}" />
                                <TextBlock x:Name="DrawerPageDesc" Text="—"
                                           Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- 底部 Dock：导航、命令入口、状态与版本 -->
        <Grid x:Name="StatusBar" Grid.Row="2" Background="Transparent">
            <Grid.RowDefinitions>
                <RowDefinition Height="20" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 跨两行测量，避免被 20px 的空白行压缩高度导致文字上下被裁。 -->
            <Grid x:Name="DockHintHost" Grid.RowSpan="2" HorizontalAlignment="Left" VerticalAlignment="Top"
                  Visibility="Collapsed" Opacity="0" IsHitTestVisible="False">
                <Border x:Name="DockHint"
                        HorizontalAlignment="Center"
                        Background="{ThemeResource FloatSurfaceBrush}"
                        BorderBrush="{ThemeResource BorderStrongBrush}" BorderThickness="1"
                        CornerRadius="6" Padding="8,3">
                    <TextBlock x:Name="DockHintText" Text="" FontSize="11.5" TextWrapping="NoWrap"
                               Foreground="{ThemeResource SubTextBrush}" />
                </Border>
            </Grid>

            <Grid Grid.Row="1" Padding="18,0">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                            HorizontalAlignment="Left">
                    <ProgressRing x:Name="StatusRing" Width="12" Height="12" IsActive="False"
                                  Foreground="{ThemeResource AccentBrush}" />
                    <TextBlock x:Name="StatusText" Text="正在启动..." FontSize="11.5"
                               Foreground="{ThemeResource SubTextBrush}" VerticalAlignment="Center" />
                    <Border x:Name="StatusSecureDivider" Width="1" Height="11"
                            Background="{ThemeResource BorderBrush}" Margin="6,0" Opacity="0.8" />
                    <TextBlock x:Name="StatusSecureText" Text="本地运行 · 不上传数据"
                               Style="{StaticResource CaptionTextStyle}" />
                </StackPanel>

                <Border x:Name="DockBar" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="{ThemeResource FloatSurfaceBrush}"
                        BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1"
                        CornerRadius="16" Padding="7,5">
                    <StackPanel Orientation="Horizontal" Spacing="1">
                        <Button x:Name="DockOverview" Tag="overview" Click="DockItem_Click"
                                Style="{StaticResource DockButtonStyle}" AutomationProperties.Name="概览">
                            <FontIcon Glyph="&#xE80F;" FontSize="17" />
                        </Button>
                        <Button x:Name="DockItems" Tag="items" Click="DockItem_Click"
                                Style="{StaticResource DockButtonStyle}" AutomationProperties.Name="优化项">
                            <FontIcon Glyph="&#xE9D9;" FontSize="17" />
                        </Button>
                        <Button x:Name="DockDiagnostics" Tag="diagnostics" Click="DockItem_Click"
                                Style="{StaticResource DockButtonStyle}" AutomationProperties.Name="诊断报告">
                            <FontIcon Glyph="&#xE9D5;" FontSize="17" />
                        </Button>
                        <Button x:Name="DockStartup" Tag="startup" Click="DockItem_Click"
                                Style="{StaticResource DockButtonStyle}" AutomationProperties.Name="启动项与后台">
                            <FontIcon Glyph="&#xE7C4;" FontSize="17" />
                        </Button>

                        <Border x:Name="DockSep1" Width="1" Height="22"
                                Background="{ThemeResource BorderBrush}"
                                Opacity="0.7" Margin="5,0" />

                        <Button x:Name="DockGames" Tag="games" Click="DockItem_Click"
                                Style="{StaticResource DockButtonStyle}" AutomationProperties.Name="游戏库">
                            <FontIcon Glyph="&#xE7FC;" FontSize="17" />
                        </Button>
                        <Button x:Name="DockDriver" Tag="driver" Click="DockItem_Click"
                                Style="{StaticResource DockButtonStyle}" AutomationProperties.Name="驱动中心">
                            <FontIcon Glyph="&#xE7F8;" FontSize="17" />
                        </Button>
                        <Button x:Name="DockBackup" Tag="backup" Click="DockItem_Click"
                                Style="{StaticResource DockButtonStyle}" AutomationProperties.Name="备份还原">
                            <FontIcon Glyph="&#xE777;" FontSize="17" />
                        </Button>
                        <Button x:Name="DockLog" Tag="log" Click="DockItem_Click"
                                Style="{StaticResource DockButtonStyle}" AutomationProperties.Name="运行日志">
                            <FontIcon Glyph="&#xE8A5;" FontSize="17" />
                        </Button>

                        <Border x:Name="DockSep2" Width="1" Height="22"
                                Background="{ThemeResource BorderBrush}"
                                Opacity="0.7" Margin="5,0" />

                        <Button x:Name="DockSettings" Tag="settings" Click="DockItem_Click"
                                Style="{StaticResource DockButtonStyle}" AutomationProperties.Name="设置">
                            <FontIcon Glyph="&#xE713;" FontSize="17" />
                        </Button>
                        <Button x:Name="DockAbout" Tag="about" Click="DockItem_Click"
                                Style="{StaticResource DockButtonStyle}" AutomationProperties.Name="关于与支持">
                            <FontIcon Glyph="&#xE946;" FontSize="17" />
                        </Button>

                        <Border x:Name="DockSep3" Width="1" Height="22"
                                Background="{ThemeResource BorderBrush}"
                                Opacity="0.7" Margin="5,0" />

                        <Button x:Name="DockCommand" Click="CommandButton_Click"
                                Style="{StaticResource DockButtonStyle}"
                                Background="{ThemeResource AccentSoftBrush}"
                                Foreground="{ThemeResource AccentBrush}"
                                AutomationProperties.Name="命令面板">
                            <FontIcon Glyph="&#xE721;" FontSize="16" />
                        </Button>
                    </StackPanel>
                </Border>

                <StackPanel x:Name="StatusRight" Orientation="Horizontal"
                            HorizontalAlignment="Right" Spacing="12" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                        <Ellipse x:Name="StatusEngineDot" Width="5" Height="5"
                                 Fill="{ThemeResource WarnBrush}" VerticalAlignment="Center" />
                        <TextBlock x:Name="EngineStateText" Text="引擎未连接" FontSize="11.5"
                                   Foreground="{ThemeResource SubTextBrush}" />
                    </StackPanel>
                    <Border Width="1" Height="11" Background="{ThemeResource BorderBrush}" Opacity="0.8" />
                    <TextBlock x:Name="VersionText" Text="WinUI 3" Style="{StaticResource TechCodeStyle}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- 待优化悬浮清单：跟随感叹号出现在顶栏下方，留在窗口内以便跟随主题 -->
        <Border x:Name="PendingTipCard" Grid.RowSpan="3" Visibility="Collapsed"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                Background="{ThemeResource DrawerSurfaceBrush}" BorderBrush="{ThemeResource BorderBrush}"
                BorderThickness="1" CornerRadius="10" Padding="12,10"
                MinWidth="200" MaxWidth="320">
            <StackPanel Spacing="7">
                <TextBlock x:Name="PendingTipTitle" FontSize="12" FontWeight="SemiBold"
                           Foreground="{ThemeResource WarnBrush}" TextWrapping="NoWrap" />
                <StackPanel x:Name="PendingTipList" Spacing="4" />
                <TextBlock x:Name="PendingTipHint" FontSize="11"
                           Foreground="{ThemeResource SubTextBrush}" TextWrapping="NoWrap" />
            </StackPanel>
        </Border>

        <!-- 命令面板：覆盖整个窗口，Ctrl+K 或 Dock 的搜索按钮打开 -->
        <controls:CommandPalette x:Name="Palette" Grid.RowSpan="3"
                                 VerticalAlignment="Stretch" HorizontalAlignment="Stretch" />
    </Grid>
</Window>

